--- /dev/null
+++ b/src/components/FamilyTimetable.tsx
@@ -0,0 +1,74 @@
+"use client";
+import {useState} from 'react';
+import {useApiData} from '@/hooks/useApiData';
+
+type Period={label:string;start:string;end:string;kind:string;subject:string|null;teacher:string|null;period_verified:boolean;teacher_account_linked:boolean};
+type Incharge={name:string|null;teachers:string[];source:string;staff_identity_verified:boolean;note:string|null};
+type Child={student_id:number;name:string;class:string;section:string;class_incharge:Incharge;timetable_status:string;periods:Period[]};
+type FamilyData={version:string;day:string;profile:string;children:Child[]};
+const EMPTY:FamilyData={version:'',day:'',profile:'',children:[]};
+const DAYS=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
+const todayInSchool=()=>{
+ const day=new Intl.DateTimeFormat('en-US',{weekday:'long',timeZone:'Asia/Karachi'}).format(new Date());
+ return DAYS.includes(day)?day:'Monday';
+};
+const friendlyTime=(value:string)=>{
+ const [h,m]=value.split(':').map(Number);
+ return String((h%12)||12)+':'+String(m).padStart(2,'0')+(h>=12?' PM':' AM');
+};
+export default function FamilyTimetable(){
+ const [day,setDay]=useState(todayInSchool);
+ const {data,loading,error,refetch}=useApiData<FamilyData>('/portal/family-timetable?day='+encodeURIComponent(day),EMPTY,[day]);
+ return <section className="mt-6 rounded-[18px] border border-[#d8e5dd] bg-white p-4 shadow-sm sm:p-5" aria-label="Your children's class timetables">
+  <div className="flex flex-wrap items-start justify-between gap-3">
+   <div><p className="text-[11px] font-bold uppercase tracking-[.13em] text-[#397667]">School timetable</p>
+    <h2 className="mt-1 text-lg font-bold text-[#283c37]">Your child’s classes & teachers</h2>
+    <p className="mt-1 text-xs text-[#536960]">Official period timings in Pakistan school time. Friday has no break.</p></div>
+   <label className="flex items-center gap-2 text-xs font-semibold text-[#37594d]">School day
+    <select aria-label="Select school day" value={day} onChange={e=>setDay(e.target.value)} className="rounded-lg border border-[#a9c7bd] bg-[#f7fcf8] px-3 py-2 text-[#263f36]">
+     {DAYS.map(d=><option key={d} value={d}>{d}</option>)}
+    </select>
+   </label>
+  </div>
+  {loading?<p className="mt-5 rounded-lg bg-[#f5f8f5] p-4 text-sm text-[#435c52]" role="status">Loading verified timetable…</p>:
+  error?<div className="mt-5 rounded-lg border border-[#d0a9a2] bg-[#fff8f6] p-4 text-sm text-[#6d3834]" role="alert">
+    Timetable could not be verified. The school schedule has not been replaced by guessed data.
+    <button type="button" onClick={refetch} className="ml-3 underline">Retry</button>
+   </div>:
+  !data.children.length?<p className="mt-5 rounded-lg border border-[#e0e5db] bg-[#f8faf7] p-4 text-sm text-[#52665b]">
+    No linked child record was found for this account. Ask the school to verify your parent–student link.
+   </p>:
+  <div className="mt-4 space-y-5">
+   {data.children.map(child=><article key={child.student_id} className="overflow-hidden rounded-xl border border-[#c0d4c9]">
+    <div className="flex flex-wrap items-start justify-between gap-2 bg-[#edf7f2] px-4 py-3">
+     <div><h3 className="text-sm font-extrabold text-[#26483b]">{child.name}</h3>
+      <p className="text-xs text-[#3d6254]">Class {child.class} · {child.section||'No section'}</p></div>
+     <div className="text-left sm:text-right">
+      <p className="text-[11px] font-bold uppercase tracking-wide text-[#51776b]">Class incharge</p>
+      <p className="text-sm font-bold text-[#244f41]">{child.class_incharge.name||'Not designated'}</p>
+      {child.class_incharge.teachers.length>1?<p className="text-xs text-[#465d56]">Teachers: {child.class_incharge.teachers.join(' & ')}</p>:null}
+     </div>
+    </div>
+    {child.timetable_status!=='complete'?<p className="border-t border-[#d9e7dd] bg-[#fffaf1] px-4 py-2 text-xs font-medium text-[#7f5c32]">
+      Subject allocations are pending verified publication. Unconfirmed subjects and teachers are intentionally left blank.
+     </p>:null}
+    <div className="overflow-x-auto">
+     <table className="w-full min-w-[540px] border-collapse text-left text-xs sm:text-sm">
+      <thead><tr className="bg-[#e6f1f8] text-[#25495e]">
+       <th className="border border-[#aec6ce] px-3 py-2">Period</th>
+       <th className="border border-[#aec6ce] px-3 py-2">Time</th>
+       <th className="border border-[#aec6ce] px-3 py-2">Subject</th>
+       <th className="border border-[#aec6ce] px-3 py-2">Teacher</th>
+      </tr></thead>
+      <tbody>{child.periods.map(p=><tr key={p.label} className={p.kind==='break'?'bg-[#fff3de]':p.kind==='assembly'?'bg-[#f0eef8]':'even:bg-[#fbfdfb]'}>
+       <th scope="row" className="border border-[#cadad2] px-3 py-2 font-semibold text-[#314d44]">{p.label}</th>
+       <td className="whitespace-nowrap border border-[#cadad2] px-3 py-2 text-[#35534a]">{friendlyTime(p.start)} – {friendlyTime(p.end)}</td>
+       <td className="border border-[#cadad2] px-3 py-2 font-medium text-[#334e44]">{p.kind==='teaching'?(p.subject||'Awaiting verified allocation'):'—'}</td>
+       <td className="border border-[#cadad2] px-3 py-2 text-[#405c50]">{p.kind==='teaching'?(p.teacher||'Not confirmed'):'—'}</td>
+      </tr>)}</tbody>
+     </table>
+    </div>
+   </article>)}
+  </div>}
+ </section>;
+}
