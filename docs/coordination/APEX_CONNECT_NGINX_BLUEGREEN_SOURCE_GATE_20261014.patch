+'use strict';
+const assert=require('node:assert/strict');
+const {check,staticRouteState,sourceNextDashboardRedirect}=require('./check-nginx-bluegreen-routing-20261014.cjs');
+let passed=0;function verify(n,fn){fn();console.log('PASS '+n);passed++;}
+const blue=`server { listen 443 ssl http2; location = /dashboard { return 307 /admin; } location ^~ /dashboard/ { return 307 /admin; } location / { proxy_pass http://127.0.0.1:3000; } }`;
+const green=`server { listen 127.0.0.1:3017 ssl http2; location / { proxy_pass http://127.0.0.1:3016; } }`;
+const oldNext=`async redirects() { return [{source: "/dashboard", destination: "/admin", permanent:false}] }`;
+const goodNext=`const nextConfig = {reactStrictMode: true}; export default nextConfig;`;
+verify('baseline catches both old Nginx forced redirects',()=>assert.equal(staticRouteState(blue).dashboardOverrideCount,2));
+verify('green detects no old Nginx /dashboard redirect',()=>assert.equal(staticRouteState(green).dashboardOverrideCount,0));
+verify('Next old unconditional dashboard redirect rejected',()=>assert(sourceNextDashboardRedirect(oldNext)));
+verify('Next corrected file accepts no forced dashboard',()=>assert(!sourceNextDashboardRedirect(goodNext)));
+verify('isolated green configuration has all 5 correct properties',()=>{
+ const r=check({blue,green,greenNext:goodNext});
+ assert(r.blueExpectedBaseline&&r.greenNoNginxDashboardOverride&&r.greenUsesIsolatedCandidatePort&&r.greenHasNoUnconditionalNextDashboardRedirect&&r.greenBoundToLoopback);
+});
+verify('baseline upstream drift is rejected',()=>assert.equal(check({blue:blue.replace(':3000',':1234'),green,greenNext:goodNext}).blueExpectedBaseline,false));
+verify('green cannot silently send traffic to old blue process',()=>assert.equal(check({blue,green:green.replace(':3016',':3000'),greenNext:goodNext}).greenUsesIsolatedCandidatePort,false));
+verify('green must be private loopback for this rehearsal',()=>assert.equal(check({blue,green:green.replace('127.0.0.1:3017','443'),greenNext:goodNext}).greenBoundToLoopback,false));
+verify('green old Next redirect is rejected even with fixed Nginx',()=>assert.equal(check({blue,green,greenNext:oldNext}).greenHasNoUnconditionalNextDashboardRedirect,false));
+console.log('CONNECT_NGINX_BLUEGREEN_BOUNDARY '+passed+'/'+passed+' PASS');
