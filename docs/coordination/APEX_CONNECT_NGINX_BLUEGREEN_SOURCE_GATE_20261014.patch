+#!/usr/bin/env node
+'use strict';
+// Release preflight only. Never modifies production Nginx, PM2, or DB.
+// Must be paired with genuine Core-owned signed user+tenant acceptance.
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const crypto=require('node:crypto');
+function sha(x){return crypto.createHash('sha256').update(x).digest('hex');}
+function dashboardBlocks(source){
+  // Read the two complete simple location blocks as deployed: '=' and '^~'.
+  return [...source.matchAll(/location\s+(?:=|\^~)\s+(\/dashboard\/?)\s*\{([^{}]*)\}/g)]
+    .map(x=>({path:x[1],body:x[2]}));
+}
+function staticRouteState(source){
+  const blocks=dashboardBlocks(source);
+  const hardcoded=blocks.filter(x=>/\breturn\s+30[1278]\s+(?:https?:\/\/[^/;]+)?\/admin\s*;/i.test(x.body));
+  const upstream=source.match(/location\s+\/\s*\{[\s\S]*?\bproxy_pass\s+http:\/\/127\.0\.0\.1:(\d+)\s*;/);
+  return {dashboardOverrideCount:hardcoded.length,hardcodedPaths:hardcoded.map(x=>x.path),mainUpstreamPort:upstream?Number(upstream[1]):null};
+}
+function sourceNextDashboardRedirect(source){
+  // Do not confuse protected login-side role routing with unconditional next.config.ts redirects.
+  return /source\s*:\s*["']\/dashboard(?:(?:\/):path\*|["'])/.test(source);
+}
+function check({blue,green,greenNext,expectedBluePort=3000,expectedGreenPort=3016}){
+  const old=staticRouteState(blue),candidate=staticRouteState(green);
+  return {
+    blueSourceSha256:sha(blue),greenSourceSha256:sha(green),
+    sourceNextSha256:sha(greenNext),
+    blueExpectedBaseline:old.mainUpstreamPort===expectedBluePort&&old.dashboardOverrideCount===2,
+    greenNoNginxDashboardOverride:candidate.dashboardOverrideCount===0,
+    greenUsesIsolatedCandidatePort:candidate.mainUpstreamPort===expectedGreenPort,
+    greenHasNoUnconditionalNextDashboardRedirect:!sourceNextDashboardRedirect(greenNext),
+    greenBoundToLoopback:green.includes('listen 127.0.0.1:3017 ssl http2;'),
+    baseline:old,candidate,
+  };
+}
+function getArg(s){const i=process.argv.indexOf(s);return i<0?null:process.argv[i+1];}
+function run(){
+  const old=getArg('--blue-nginx'),next=getArg('--green-nginx'),source=getArg('--green-next');
+  if(!old||!next||!source) throw Error('--blue-nginx, --green-nginx, --green-next absolute paths required');
+  for(const p of [old,next,source])assert(p.startsWith('/'),'Source paths must be absolute');
+  const result=check({blue:fs.readFileSync(old,'utf8'),green:fs.readFileSync(next,'utf8'),greenNext:fs.readFileSync(source,'utf8')});
+  const passes=['blueExpectedBaseline','greenNoNginxDashboardOverride','greenUsesIsolatedCandidatePort','greenHasNoUnconditionalNextDashboardRedirect','greenBoundToLoopback'];
+  const ready=passes.every(k=>result[k]);
+  console.log(JSON.stringify({gate:'CONNECT_NGINX_BLUEGREEN_LOOPBACK_PREFLIGHT',status:ready?'PASS_ISOLATED_CONFIG_ONLY':'FAIL',productionPromoted:false,productionWrites:false,scopedReleaseOnly:true,blocked:passes.filter(k=>!result[k]),...result},null,2));
+  process.exitCode=ready?0:2;
+}
+if(require.main===module)try{run()}catch(e){console.error('NGINX_GREEN_PREFLIGHT BLOCK '+e.message);process.exitCode=3;}
+module.exports={check,staticRouteState,sourceNextDashboardRedirect};
