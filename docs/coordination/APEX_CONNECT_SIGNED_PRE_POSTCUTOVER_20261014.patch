+#!/usr/bin/env node
+'use strict';
+// Authenticated, source-pinned preflight for SaaS Core's LOGIN-ONLY cutover.
+// This script NEVER deploys, signs evidence, reads passwords or grants roles.
+// Genuine teacher LIVE acceptance and traffic rollback are POST-cutover gates.
+const fs=require('node:fs');
+const path=require('node:path');
+const crypto=require('node:crypto');
+const {check}=require('./check-nginx-bluegreen-routing-20261014.cjs');
+const TRUST='/etc/assps/release-evidence-ed25519.pub';
+const sha=x=>crypto.createHash('sha256').update(x).digest('hex');
+const HEX=/^[0-9a-f]{64}$/;
+const PRE_KIND='precutover_core_owner_signed_release_acceptance';
+const REQUIRED=['backup_integrity_verified','compiled_artifact_and_nginx_reviewed',
+  'signed_runtime_school_tenant_verified','independent_peer_school_denied',
+  'unauthorized_subject_denied','rollback_rehearsed_without_data_mutation',
+  'academic_results_published_false'];
+function selectArg(args,name,defaultValue='') {
+  const k=args.indexOf(name);
+  return k<0?defaultValue:args[k+1];
+}
+function signedPreflight(receipt,key,expected,now=Date.now()) {
+  if (!key || !receipt || typeof receipt.payload_b64!=='string' ||
+      typeof receipt.signature_b64!=='string') return null;
+  try {
+    const data=Buffer.from(receipt.payload_b64,'base64');
+    const signature=Buffer.from(receipt.signature_b64,'base64');
+    if(data.length<64||data.length>16384||signature.length!==64 ||
+      !crypto.verify(null,data,key,signature)) return null;
+    const c=JSON.parse(data.toString('utf8'));
+    if(!c||c.kind!==PRE_KIND||c.issuer!=='SAAS_CORE'||
+      c.environment!=='production'||c.school_id!==1||
+      c.actor_role!=='core_release_owner'||c.release_scope!=='CONNECT_LOGIN_ONLY'||
+      c.release_id!==expected.releaseId||
+      c.source_sha256!==expected.sourceSha||
+      c.build_id!==expected.buildId||
+      c.origin!==expected.origin||
+      c.nginx_blue_sha256!==expected.blueSha||
+      c.nginx_green_sha256!==expected.greenSha||
+      c.backup_sha256!==expected.backupSha ||
+      c.core_signed_runtime_evidence_sha256!==expected.coreSha ||
+      c.academic_results_published!==false || c.status!=='PASS' ||
+      typeof c.evidence_digest!=='string' || !HEX.test(c.evidence_digest)) return null;
+    if(REQUIRED.some(k=>c[k]!==true)) return null;
+    const ts=Date.parse(c.observed_at);
+    if(!Number.isFinite(ts)||ts>now+300000||ts<now-3600000) return null;
+    return c;
+  } catch { return null; }
+}
+function verifiedOwnerKeyFromSystem() {
+  try {
+    const st=fs.lstatSync(TRUST);
+    if(!st.isFile()||st.uid!==0||(st.mode&0o022)!==0)return null;
+    const key=crypto.createPublicKey(fs.readFileSync(TRUST));
+    return key.asymmetricKeyType==='ed25519'?key:null;
+  } catch{return null;}
+}
+function evaluate({candidateRoot,blueNginx,greenNginx,backupFile,coreFile,
+  expected,ownerKey,receipt,now=Date.now()}) {
+  const checks=[];
+  const add=(name,passed)=>checks.push({name,pass:!!passed});
+  let blue='',green='',next='',proxy='',build='',backup='',core='';
+  try { blue=fs.readFileSync(blueNginx,'utf8'); }catch {}
+  try { green=fs.readFileSync(greenNginx,'utf8'); }catch {}
+  try { next=fs.readFileSync(path.join(candidateRoot,'next.config.ts'),'utf8'); }catch {}
+  try { proxy=fs.readFileSync(path.join(candidateRoot,'src/proxy.ts')); }catch {}
+  try { build=fs.readFileSync(path.join(candidateRoot,'.next/BUILD_ID'),'utf8').trim(); }catch {}
+  try { backup=fs.readFileSync(backupFile); }catch {}
+  try { core=fs.readFileSync(coreFile); }catch {}
+  const route=check({blue,green,greenNext:next});
+  add('reviewed_auth_source_hash',sha(proxy)===expected.sourceSha);
+  add('reviewed_candidate_compiled_build',build===expected.buildId);
+  add('current_blue_ingress_pinned',route.blueExpectedBaseline&&
+    route.blueSourceSha256===expected.blueSha);
+  add('isolated_green_ingress_ready',route.greenNoNginxDashboardOverride&&
+    route.greenUsesIsolatedCandidatePort&&route.greenHasNoUnconditionalNextDashboardRedirect&&
+    route.greenBoundToLoopback&&route.greenSourceSha256===expected.greenSha);
+  add('original_backup_hash_pinned',backup.length>100000&&
+    sha(backup)===expected.backupSha);
+  let proof=null;
+  try{proof=JSON.parse(core.toString('utf8'));}catch{}
+  add('core_runtime_acceptance_payload_valid',!!proof&&
+      proof.status==='READY_FOR_LOGIN_ONLY_CORE'&&
+      proof.signed_runtime_security_certified===true&&
+      proof.academic_results_published===false&&
+      proof.exact_release_id===expected.releaseId&&
+      sha(core)===expected.coreSha);
+  add('trusted_owner_pinned_ed25519_root',!!ownerKey);
+  add('genuine_signed_core_owner_preflight',
+    !!signedPreflight(receipt,ownerKey,expected,now));
+  return {
+    phase:'PRE_CUTOVER',status:checks.every(x=>x.pass)?
+      'READY_FOR_SAAS_CORE_CONTROLLED_SWITCH':'HOLD',
+    checks,blocked:checks.filter(x=>!x.pass).map(x=>x.name),
+    productionDeploymentPerformed:false,
+    realStaffPostCutoverAcceptanceCompleted:false,
+    liveRollbackCompleted:false,
+    academicResultsPublished:false,
+  };
+}
+function main(argv=process.argv.slice(2)) {
+  const expected={
+    sourceSha:selectArg(argv,'--approved-proxy-sha256'),
+    buildId:selectArg(argv,'--approved-build-id'),
+    releaseId:selectArg(argv,'--approved-release-id'),
+    origin:selectArg(argv,'--origin','https://api.assps.edu.pk'),
+    blueSha:selectArg(argv,'--blue-nginx-sha256'),
+    greenSha:selectArg(argv,'--green-nginx-sha256'),
+    backupSha:selectArg(argv,'--backup-sha256'),
+    coreSha:selectArg(argv,'--core-acceptance-sha256'),
+  };
+  const valid=[expected.sourceSha,expected.blueSha,expected.greenSha,
+    expected.backupSha,expected.coreSha].every(x=>HEX.test(x));
+  if(!valid||!/^[A-Za-z0-9_-]{8,128}$/.test(expected.buildId)||
+    !/^[A-Za-z0-9._-]{8,160}$/.test(expected.releaseId)||
+    !/^https:\/\/[^/?#@]+$/.test(expected.origin))
+    throw Error('Explicit exact approved source, Nginx, backup and Core release identifiers required');
+  const root=selectArg(argv,'--candidate-root');
+  const blue=selectArg(argv,'--blue-nginx');
+  const green=selectArg(argv,'--green-nginx');
+  const backup=selectArg(argv,'--backup-file');
+  const core=selectArg(argv,'--core-acceptance-file');
+  const receiptFile=selectArg(argv,'--signed-receipts',
+    '/etc/assps/connect-precutover-signed-receipts.json');
+  if([root,blue,green,backup,core,receiptFile].some(x=>!path.isAbsolute(x)))
+    throw Error('Absolute source/evidence files required');
+  let bundle;
+  try{bundle=JSON.parse(fs.readFileSync(receiptFile,'utf8'))}catch{}
+  const ownerKey=verifiedOwnerKeyFromSystem();
+  const result=evaluate({
+    candidateRoot:root,blueNginx:blue,greenNginx:green,
+    backupFile:backup,coreFile:core,expected,ownerKey,
+    receipt:(bundle?.receipts||[]).find(x=>x?.kind===PRE_KIND)||
+      (bundle?.receipts||[])[0],
+  });
+  console.log(JSON.stringify(result,null,2));
+  process.exitCode=result.status==='READY_FOR_SAAS_CORE_CONTROLLED_SWITCH'?0:2;
+}
+if(require.main===module)try{main()}catch(e){
+  console.error('CONNECT_PRE_CUTOVER_HOLD '+e.message);process.exitCode=3;
+}
+module.exports={evaluate,signedPreflight,PRE_KIND,REQUIRED,main};
