+#!/usr/bin/env node
+'use strict';
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const path=require('node:path');
+const os=require('node:os');
+const crypto=require('node:crypto');
+const {evaluate,signedPreflight,PRE_KIND,REQUIRED}=
+  require('./verify-signed-precutover-contract-20261014.cjs');
+const sha=x=>crypto.createHash('sha256').update(x).digest('hex');
+const temp=fs.mkdtempSync(path.join(os.tmpdir(),'assps-precutover-qa-'));
+try {
+  const candidate=path.join(temp,'candidate');
+  fs.mkdirSync(path.join(candidate,'.next'),{recursive:true});
+  fs.mkdirSync(path.join(candidate,'src'),{recursive:true});
+  const proxy=Buffer.from('// reviewed Connect auth route; synthetic QA only');
+  const build='ONDwxEIZlx5onDIKY7wYf';
+  const blue=Buffer.from("location = /dashboard { return 307 /admin; }\nlocation ^~ /dashboard/ { return 307 /admin; }\nlocation / { proxy_pass http://127.0.0.1:3000; }");
+  const green=Buffer.from("listen 127.0.0.1:3017 ssl http2;\nlocation / { proxy_pass http://127.0.0.1:3016; }");
+  const backup=Buffer.alloc(101000,7); // synthetic QA bytes, never real DB
+  const preCore={status:'READY_FOR_LOGIN_ONLY_CORE',
+    signed_runtime_security_certified:true,
+    academic_results_published:false,
+    exact_release_id:'QA_PRE_CUTOVER_20261014'};
+  const core=Buffer.from(JSON.stringify(preCore));
+  const f={blue:path.join(temp,'blue.conf'),green:path.join(temp,'green.conf'),
+    backup:path.join(temp,'backup.dump'),core:path.join(temp,'core.json')};
+  fs.writeFileSync(path.join(candidate,'.next/BUILD_ID'),build);
+  fs.writeFileSync(path.join(candidate,'src/proxy.ts'),proxy);
+  fs.writeFileSync(path.join(candidate,'next.config.ts'),'export default {}');
+  fs.writeFileSync(f.blue,blue);
+  fs.writeFileSync(f.green,green);
+  fs.writeFileSync(f.backup,backup);
+  fs.writeFileSync(f.core,core);
+  const expected={sourceSha:sha(proxy),buildId:build,
+    releaseId:preCore.exact_release_id,origin:'https://api.assps.edu.pk',
+    blueSha:sha(blue),greenSha:sha(green),
+    backupSha:sha(backup),coreSha:sha(core)};
+  const {publicKey,privateKey}=crypto.generateKeyPairSync('ed25519');
+  const now=Date.now();
+  const claim={
+    kind:PRE_KIND,issuer:'SAAS_CORE',environment:'production',
+    school_id:1,actor_role:'core_release_owner',
+    release_scope:'CONNECT_LOGIN_ONLY',
+    release_id:expected.releaseId,
+    source_sha256:expected.sourceSha,
+    build_id:expected.buildId,
+    origin:expected.origin,
+    nginx_blue_sha256:expected.blueSha,
+    nginx_green_sha256:expected.greenSha,
+    backup_sha256:expected.backupSha,
+    core_signed_runtime_evidence_sha256:expected.coreSha,
+    academic_results_published:false,
+    status:'PASS',evidence_digest:'b'.repeat(64),
+    observed_at:new Date(now).toISOString(),
+  };
+  for(const k of REQUIRED)claim[k]=true;
+  function sign(body,key=privateKey) {
+    const bytes=Buffer.from(JSON.stringify(body));
+    return {payload_b64:bytes.toString('base64'),
+      signature_b64:crypto.sign(null,bytes,key).toString('base64')};
+  }
+  function result(overrides={}) {
+    return evaluate({candidateRoot:candidate,blueNginx:f.blue,
+      greenNginx:f.green,backupFile:f.backup,coreFile:f.core,
+      expected,ownerKey:publicKey,receipt:sign(claim),now,...overrides});
+  }
+  let passed=0;
+  function test(name,fn){fn();passed++;console.log('PASS '+name);}
+  test('synthetic positive fixture proves PRE code branch only',()=>{
+    const x=result();assert.equal(x.status,'READY_FOR_SAAS_CORE_CONTROLLED_SWITCH');
+    assert.equal(x.productionDeploymentPerformed,false);
+    assert.equal(x.realStaffPostCutoverAcceptanceCompleted,false);
+    assert.equal(x.liveRollbackCompleted,false);
+  });
+  test('without owner-pinned key always HOLD',()=>{
+    assert.equal(result({ownerKey:null}).status,'HOLD');
+  });
+  test('unsigned fake preflight not accepted',()=>{
+    assert.equal(result({receipt:null}).status,'HOLD');
+  });
+  test('distinct signer cannot forge ownership',()=>{
+    const other=crypto.generateKeyPairSync('ed25519');
+    assert.equal(result({receipt:sign(claim,other.privateKey)}).status,'HOLD');
+  });
+  test('signed owner claim must assert verified result and evidence digest',()=>{
+    assert.equal(result({receipt:sign({...claim,status:'HOLD'})}).status,'HOLD');
+    assert.equal(result({receipt:sign({...claim,evidence_digest:'invalid'})}).status,'HOLD');
+  });
+  test('foreign school claim rejected',()=>{
+    assert.equal(result({receipt:sign({...claim,school_id:2})}).status,'HOLD');
+  });
+  test('academic publication true rejected',()=>{
+    assert.equal(result({receipt:sign({...claim,academic_results_published:true})}).status,'HOLD');
+  });
+  test('any missing signed signed-tenant result rejected',()=>{
+    assert.equal(result({receipt:sign({...claim,signed_runtime_school_tenant_verified:false})}).status,'HOLD');
+  });
+  test('stale production receipt rejected',()=>{
+    const stale={...claim,observed_at:new Date(now-7200000).toISOString()};
+    assert.equal(result({receipt:sign(stale)}).status,'HOLD');
+  });
+  test('future attestation beyond skew rejected',()=>{
+    const future={...claim,observed_at:new Date(now+3600000).toISOString()};
+    assert.equal(result({receipt:sign(future)}).status,'HOLD');
+  });
+  test('stale old compiled Next candidate denied',()=>{
+    fs.writeFileSync(path.join(candidate,'.next/BUILD_ID'),'OLD_COMPILED_BUILD');
+    assert.equal(result().status,'HOLD');
+    fs.writeFileSync(path.join(candidate,'.next/BUILD_ID'),build);
+  });
+  test('blue redirect retained in GREEN denied',()=>{
+    fs.writeFileSync(f.green,Buffer.concat([green,Buffer.from('\nlocation = /dashboard { return 307 /admin; }')]));
+    assert.equal(result().status,'HOLD');
+    fs.writeFileSync(f.green,green);
+  });
+  test('tampered original backup denied',()=>{
+    fs.appendFileSync(f.backup,'tamper');
+    assert.equal(result().status,'HOLD');
+    fs.writeFileSync(f.backup,backup);
+  });
+  test('Core gate forged status denied even if signed hash expected fixture',()=>{
+    fs.writeFileSync(f.core,JSON.stringify({...preCore,status:'HOLD'}));
+    assert.equal(result().status,'HOLD');
+    fs.writeFileSync(f.core,core);
+  });
+  test('Next config unconditional dashboard redirect blocked',()=>{
+    fs.writeFileSync(path.join(candidate,'next.config.ts'),
+      "async redirects(){return [{source:'/dashboard', destination:'/admin', permanent:false}]}");
+    assert.equal(result().status,'HOLD');
+  });
+  assert.equal(passed,15);
+  console.log('CONNECT_PRECUTOVER_SIGNED_RELEASE_NEGATIVES '+passed+'/'+passed+' PASS');
+} finally {
+  fs.rmSync(temp,{recursive:true,force:true});
+}
