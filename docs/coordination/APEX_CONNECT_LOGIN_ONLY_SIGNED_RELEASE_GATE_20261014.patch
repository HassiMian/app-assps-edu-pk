+#!/usr/bin/env node
+'use strict';
+// Read-only supplementary SaaS Core-owned login-only release gate.
+// Does not deploy, sign evidence, touch staff credentials, write scores or override the Core release gate.
+const fs = require('node:fs');
+const path = require('node:path');
+const crypto = require('node:crypto');
+const {URL} = require('node:url');
+
+const TRUST_ROOT = '/etc/assps/release-evidence-ed25519.pub';
+const REQUIRED_KINDS = ['authorized_teacher_live_browser','signed_peer_tenant_denial','live_traffic_rollback'];
+const HEX = /^[a-f0-9]{64}$/;
+const sha = body => crypto.createHash('sha256').update(body).digest('hex');
+
+function verifyReceipt(receipt, publicKey, expected, now = Date.now()) {
+  if (!receipt || typeof receipt.payload_b64 !== 'string' ||
+      !/^[a-zA-Z0-9+/]+={0,2}$/.test(receipt.payload_b64) ||
+      typeof receipt.signature_b64 !== 'string' ||
+      !/^[a-zA-Z0-9+/]+={0,2}$/.test(receipt.signature_b64)) return null;
+  try {
+    const data = Buffer.from(receipt.payload_b64,'base64');
+    const signature = Buffer.from(receipt.signature_b64,'base64');
+    if (data.length < 30 || data.length > 16384 || signature.length !== 64 ||
+        !crypto.verify(null,data,publicKey,signature)) return null;
+    const c = JSON.parse(data.toString('utf8'));
+    if (!c || c.issuer !== 'SAAS_CORE' ||
+        c.release_scope !== 'CONNECT_LOGIN_ONLY' ||
+        c.environment !== 'production' ||
+        c.school_id !== 1 || c.status !== 'PASS' ||
+        c.source_sha256 !== expected.sourceSha ||
+        c.build_id !== expected.buildId ||
+        c.origin !== expected.origin ||
+        c.release_id !== expected.releaseId ||
+        c.academic_results_published !== false ||
+        typeof c.evidence_digest !== 'string' || !HEX.test(c.evidence_digest)) return null;
+    const ts = Date.parse(c.observed_at);
+    if (!Number.isFinite(ts) || ts > now + 300000 || ts < now-86400000) return null;
+    if (!REQUIRED_KINDS.includes(c.kind)) return null;
+    if (c.kind === 'authorized_teacher_live_browser' &&
+      !(c.actor_role === 'teacher' && c.existing_school_actor_verified === true &&
+        c.temporary_password_rotation_tested === true && c.http_only_session_verified === true)) return null;
+    if (c.kind === 'signed_peer_tenant_denial' &&
+      !(c.actor_role === 'security_reviewer' && c.cross_tenant_denial_tested === true &&
+        c.unassigned_subject_denial_tested === true)) return null;
+    if (c.kind === 'live_traffic_rollback' &&
+      !(c.actor_role === 'release_owner' && c.rollback_executed === true &&
+        c.original_build_restorable === true && c.data_integrity_preserved === true)) return null;
+    return c;
+  } catch { return null; }
+}
+
+function verifyReceipts(bundle, publicKey, expected, now=Date.now()) {
+  const claims = {};
+  for (const item of (Array.isArray(bundle?.receipts) ? bundle.receipts : [])) {
+    const c = verifyReceipt(item,publicKey,expected,now);
+    if (c && !claims[c.kind]) claims[c.kind]=c;
+  }
+  return REQUIRED_KINDS.map(name=>({name:'verified_'+name,pass:!!claims[name]}));
+}
+
+function arg(name,fallback) {
+  const i = process.argv.indexOf(name);
+  return i>=0 ? process.argv[i+1] : fallback;
+}
+
+async function main() {
+  const root = path.resolve(arg('--deployed-root','/var/www/apex-connect'));
+  const origin = arg('--origin','https://api.assps.edu.pk');
+  const expected = {
+    sourceSha:arg('--approved-proxy-sha256',''),
+    buildId:arg('--approved-build-id',''),
+    releaseId:arg('--approved-release-id',''),
+    origin,
+  };
+  if (!HEX.test(expected.sourceSha) || !/^[a-zA-Z0-9_-]{8,128}$/.test(expected.buildId) ||
+      !/^[a-zA-Z0-9._-]{8,160}$/.test(expected.releaseId) ||
+      !/^https:\/\/[^/@?#]+$/.test(origin)) {
+    throw Error('Exact reviewed source SHA, built artifact ID, approved release ID and HTTPS origin required.');
+  }
+  const checked = [];
+  function add(name,pass,details) { checked.push({name,pass,details}); }
+  const proxy=path.join(root,'src/proxy.ts');
+  const build=path.join(root,'.next/BUILD_ID');
+  const sourceHash=fs.existsSync(proxy)?sha(fs.readFileSync(proxy)):'MISSING';
+  const buildId=fs.existsSync(build)?fs.readFileSync(build,'utf8').trim():'MISSING';
+  add('deployed_reviewed_auth_proxy_sha',sourceHash===expected.sourceSha,
+    {observed:sourceHash,expected:expected.sourceSha});
+  add('deployed_reviewed_next_build_id',buildId===expected.buildId,
+    {observed:buildId,expected:expected.buildId});
+
+  const routes=[
+    ['/login',200],
+    ['/dashboard',307,'/login','/admin'],
+    ['/teacher',302,'/login','/teacher'],
+    ['/api/auth/me',401],
+    ['/auth/change-password',200],
+    ['/teacher/assessments/report-cards',302,'/login'],
+  ];
+  for (const [url,status,target,next] of routes) {
+    try {
+      const response=await fetch(origin+url,{redirect:'manual',signal:AbortSignal.timeout(5500),
+        headers:{'Cache-Control':'no-cache'}});
+      const location=response.headers.get('location');
+      const destination=location?new URL(location,origin):null;
+      const pass=response.status===status && (!target ||
+        (destination && destination.origin===origin && destination.pathname===target &&
+         (next===undefined || destination.searchParams.get('next')===next)));
+      add('live_anonymous_'+url,!!pass,{
+        status:response.status,location:destination?.pathname||null,
+        next:destination?.searchParams.get('next')||null
+      });
+    } catch(e) { add('live_anonymous_'+url,false,{error:e.name}); }
+  }
+  let trusted=null;
+  try {
+    const stat=fs.statSync(TRUST_ROOT);
+    if(stat.uid!==0 || !stat.isFile() || (stat.mode&0o022)!==0)throw Error('untrusted public key permissions');
+    trusted=crypto.createPublicKey(fs.readFileSync(TRUST_ROOT));
+    if(trusted.asymmetricKeyType!=='ed25519')trusted=null;
+  } catch {}
+  add('saas_core_pinned_trusted_public_key',!!trusted,{trustRoot:TRUST_ROOT,present:!!trusted});
+  let bundle;
+  try{bundle=JSON.parse(fs.readFileSync(arg('--signed-receipts','/etc/assps/connect-login-release-receipts.json'),'utf8'))}catch{}
+  for(const result of verifyReceipts(bundle,trusted,expected))add(result.name,result.pass);
+  const pass=checked.every(v=>v.pass);
+  console.log(JSON.stringify({
+    gate:'CONNECT_LOGIN_ONLY_PRODUCTION_VERIFICATION_20261014',
+    status:pass?'READY_FOR_CORE_RELEASE_OWNER_FINAL_ATTESTATION':'HOLD',
+    productionDeploymentPerformed:false,
+    academicResultsPublicationAuthorized:false,
+    productionWrites:false,
+    observedAt:new Date().toISOString(),
+    reviewedRelease:expected.releaseId,
+    checks:checked,
+    blocked:checked.filter(x=>!x.pass).map(x=>x.name),
+  },null,2));
+  process.exitCode=pass?0:2;
+}
+if(require.main===module)main().catch(e=>{console.error('CONNECT_LOGIN_ONLY_RELEASE_GATE BLOCK '+e.message);process.exitCode=3});
+module.exports={verifyReceipt,verifyReceipts,REQUIRED_KINDS};
