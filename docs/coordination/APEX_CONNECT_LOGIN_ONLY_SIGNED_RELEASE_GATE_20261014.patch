+'use strict';
+// All signer keys and claims in THIS UNIT TEST are disposable synthetic fixtures.
+// Production CLI accepts ONLY SaaS Core's owner-pinned trust root, never this key.
+const assert=require('node:assert/strict');
+const crypto=require('node:crypto');
+const {verifyReceipt,verifyReceipts,REQUIRED_KINDS}=require('./verify-login-only-production-release-20261014.cjs');
+let n=0;
+function check(name,fn){fn();console.log('PASS '+name);n++}
+const {privateKey,publicKey}=crypto.generateKeyPairSync('ed25519');
+const expected={sourceSha:'a'.repeat(64),buildId:'SYNTHETIC_QA_BUILD_ONLY',releaseId:'SYNTHETIC_QA_RELEASE_ONLY',origin:'https://qa.invalid'};
+const observedAt='2026-10-14T12:00:00.000Z',now=Date.parse(observedAt);
+const claims={
+  authorized_teacher_live_browser:{actor_role:'teacher',existing_school_actor_verified:true,temporary_password_rotation_tested:true,http_only_session_verified:true},
+  signed_peer_tenant_denial:{actor_role:'security_reviewer',cross_tenant_denial_tested:true,unassigned_subject_denial_tested:true},
+  live_traffic_rollback:{actor_role:'release_owner',rollback_executed:true,original_build_restorable:true,data_integrity_preserved:true},
+};
+function receipt(kind,updates={}){
+  const payload={issuer:'SAAS_CORE',release_scope:'CONNECT_LOGIN_ONLY',environment:'production',
+    school_id:1,status:'PASS',source_sha256:expected.sourceSha,build_id:expected.buildId,
+    origin:expected.origin,release_id:expected.releaseId,academic_results_published:false,
+    evidence_digest:'b'.repeat(64),observed_at:observedAt,
+    kind,...claims[kind],...updates};
+  const raw=Buffer.from(JSON.stringify(payload));
+  return {payload_b64:raw.toString('base64'),signature_b64:crypto.sign(null,raw,privateKey).toString('base64')};
+}
+check('three synthetic verified signatures satisfy isolated verifier',()=>{
+  const proof={receipts:REQUIRED_KINDS.map(k=>receipt(k))};
+  assert(verifyReceipts(proof,publicKey,expected,now).every(x=>x.pass));
+});
+check('unsigned bundle always rejects',()=>{
+  const x=receipt(REQUIRED_KINDS[0]);x.signature_b64=Buffer.alloc(64).toString('base64');
+  assert.equal(verifyReceipt(x,publicKey,expected,now),null);
+});
+check('wrong signing authority key rejected',()=>{
+  const another=crypto.generateKeyPairSync('ed25519');
+  assert.equal(verifyReceipt(receipt(REQUIRED_KINDS[0]),another.publicKey,expected,now),null);
+});
+check('historical/stale evidence rejected',()=>{
+  assert.equal(verifyReceipt(receipt(REQUIRED_KINDS[0],{observed_at:'2026-10-11T12:00:00.000Z'}),publicKey,expected,now),null);
+});
+check('wrong actor school and role rejected',()=>{
+  assert.equal(verifyReceipt(receipt(REQUIRED_KINDS[0],{school_id:2}),publicKey,expected,now),null);
+  assert.equal(verifyReceipt(receipt(REQUIRED_KINDS[0],{actor_role:'student'}),publicKey,expected,now),null);
+});
+check('wrong source/build/release binding rejected',()=>{
+  assert.equal(verifyReceipt(receipt(REQUIRED_KINDS[0],{source_sha256:'c'.repeat(64)}),publicKey,expected,now),null);
+  assert.equal(verifyReceipt(receipt(REQUIRED_KINDS[0],{build_id:'UNVERIFIED_BUILD'}),publicKey,expected,now),null);
+  assert.equal(verifyReceipt(receipt(REQUIRED_KINDS[0],{release_id:'SYNTHETIC_OLD_RELEASE'}),publicKey,expected,now),null);
+});
+check('academic-results publication cannot piggyback login-only gate',()=>{
+  assert.equal(verifyReceipt(receipt(REQUIRED_KINDS[0],{academic_results_published:true}),publicKey,expected,now),null);
+});
+check('fake temporary actor not equivalent to real teacher acceptance',()=>{
+  assert.equal(verifyReceipt(receipt(REQUIRED_KINDS[0],{existing_school_actor_verified:false}),publicKey,expected,now),null);
+});
+check('invalid tenant denial and absent original build restoration fail',()=>{
+  assert.equal(verifyReceipt(receipt('signed_peer_tenant_denial',{cross_tenant_denial_tested:false}),publicKey,expected,now),null);
+  assert.equal(verifyReceipt(receipt('live_traffic_rollback',{original_build_restorable:false}),publicKey,expected,now),null);
+});
+check('missing evidence or owner public key leaves every gate on hold',()=>{
+  assert(verifyReceipts(null,null,expected,now).every(x=>!x.pass));
+});
+console.log('CONNECT_LOGIN_ONLY_SIGNED_RELEASE_EVIDENCE_TEST '+n+'/'+n+' PASS; SYNTHETIC_TEST_ONLY');
