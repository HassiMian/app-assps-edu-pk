+'use strict';
+// Real isolated Chromium/Next compiled route regression, never teacher impersonation.
+// Live public request is read-only and reported as diagnostic, not acceptance.
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const cp=require('node:child_process');
+const path=require('node:path');
+const root=process.env.CONNECT_QA_COMPILED_ROOT;
+const browserRoot=process.env.CONNECT_BROWSER_TOOLING_ROOT;
+const port=3016;
+const host='api.assps.edu.pk';
+if(process.env.CONNECT_ISOLATED_QA!=='yes'||!root||!browserRoot)throw Error('ISOLATED_RUNTIME_REQUIRED');
+if(!fs.existsSync(path.join(root,'.next/BUILD_ID')))throw Error('REVIEWED_COMPILED_BUILD_MISSING');
+const build=fs.readFileSync(path.join(root,'.next/BUILD_ID'),'utf8').trim();
+assert.equal(build,'aMD_UNZVOSO2lpyRO0-RO','ONLY_REVIEWED_ROLE_NEUTRAL_BUILD');
+const {chromium}=require(path.join(browserRoot,'node_modules/playwright'));
+const browserPath='/root/.cache/ms-playwright/chromium-1148/chrome-linux/chrome';
+if(!fs.existsSync(browserPath))throw Error('REVIEWED_CHROMIUM_NOT_INSTALLED');
+const origin='http://'+host+':'+port;
+let browser;
+const checks=[];
+let privateRequests=0;
+let blockedExternalRequests=0;
+function pass(name,predicate){assert.ok(predicate,name);checks.push(name);console.log('PASS '+name);}
+(async()=>{
+  browser=await chromium.launch({executablePath:browserPath,headless:true,args:[
+    '--no-sandbox','--disable-dev-shm-usage',
+    '--host-resolver-rules=MAP '+host+' 127.0.0.1, EXCLUDE localhost',
+  ]});
+  const context=await browser.newContext({ignoreHTTPSErrors:false});
+  // No external application requests or production user sessions permitted.
+  await context.route('**/*',route=>{
+    const dest=new URL(route.request().url());
+    if(dest.hostname===host&&dest.port===String(port)&&dest.protocol==='http:'){
+      privateRequests++;
+      return route.continue();
+    }
+    blockedExternalRequests++;
+    return route.abort('blockedbyclient');
+  });
+  const page=await context.newPage();
+  const faults=[];
+  page.on('pageerror',x=>faults.push(String(x.message)));
+  const response=await page.goto(origin+'/dashboard',{waitUntil:'domcontentloaded',timeout:20000});
+  const current=new URL(page.url());
+  pass('anonymous dashboard routes to LOGIN, never admin',current.pathname==='/login'&&
+    !current.searchParams.get('next')?.includes('/admin'));
+  pass('compiled dashboard HTTP routing is a redirect',response&&
+    [200,302,307,308].includes(response.status()));
+  const legacy=await page.goto(origin+'/dashboard/history',{waitUntil:'domcontentloaded',timeout:20000});
+  pass('nested legacy dashboard avoids admin login target',
+    new URL(page.url()).pathname==='/login'&&
+    !page.url().includes('next=%2Fadmin'));
+  const teacher=await page.goto(origin+'/teacher',{waitUntil:'domcontentloaded',timeout:20000});
+  const t=new URL(page.url());
+  pass('unauthenticated teacher route requires login',t.pathname==='/login');
+  pass('teacher login link preserves teacher-specific destination',
+    t.searchParams.get('next')==='/teacher');
+  const login=await page.goto(origin+'/login',{waitUntil:'domcontentloaded',timeout:20000});
+  pass('reviewed compiled login page responds',login&&login.status()===200);
+  pass('no browser JavaScript uncaught exception on anonymous routes',faults.length===0);
+  pass('browser accessed private Next and all off-host requests were intercepted',privateRequests>0);
+  console.log('BROWSER_PRIVATE_REQUESTS='+privateRequests+' EXTERNAL_BLOCKED='+blockedExternalRequests);
+  console.log('ROLE_NEUTRAL_REAL_CHROMIUM_ISOLATED '+checks.length+'/'+checks.length+' PASS');
+})().catch(e=>{console.error('ROLE_NEUTRAL_REAL_CHROMIUM_QA_FAIL '+(e&&e.message));process.exitCode=2})
+.finally(async()=>{if(browser)await browser.close()});
