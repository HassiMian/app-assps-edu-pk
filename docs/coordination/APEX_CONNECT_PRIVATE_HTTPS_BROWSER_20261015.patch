+'use strict';
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const path=require('node:path');
+if(process.env.CONNECT_ISOLATED_QA!=='yes')throw Error('ISOLATED_ONLY');
+const {chromium}=require(path.join(process.env.CONNECT_BROWSER_TOOLING_ROOT,'node_modules/playwright'));
+const port=3017, host='api.assps.edu.pk';
+const hostname='https://'+host+':'+port;
+let browser, requests=0, rejected=0, count=0;
+function check(msg,condition){assert.ok(condition,msg);count++;console.log('PASS '+msg)}
+(async()=>{
+ browser=await chromium.launch({headless:true,executablePath:'/root/.cache/ms-playwright/chromium-1148/chrome-linux/chrome',
+  args:['--no-sandbox','--disable-dev-shm-usage','--host-resolver-rules=MAP '+host+' 127.0.0.1, EXCLUDE localhost']});
+ const ctx=await browser.newContext({ignoreHTTPSErrors:false});
+ await ctx.route('**/*',route=>{
+   const u=new URL(route.request().url());
+   if(u.hostname===host&&u.port===String(port)&&u.protocol==='https:'){requests++;return route.continue();}
+   rejected++;return route.abort('blockedbyclient');
+ });
+ const page=await ctx.newPage();
+ const errors=[];
+ page.on('pageerror',x=>errors.push(x.message));
+ const login=await page.goto(hostname+'/login',{waitUntil:'domcontentloaded',timeout:20000});
+ check('Nginx HTTPS login returns 200',login.status()===200);
+ check('login reached HTTPS loopback transport',page.url().startsWith(hostname+'/login'));
+ const dashboard=await page.goto(hostname+'/dashboard',{waitUntil:'domcontentloaded',timeout:20000});
+ check('anonymous legacy dashboard has role-neutral login',new URL(page.url()).pathname==='/login'&&new URL(page.url()).searchParams.get('next')===null);
+ const nested=await page.goto(hostname+'/dashboard/history',{waitUntil:'domcontentloaded',timeout:20000});
+ check('nested legacy dashboard has role-neutral login',new URL(page.url()).pathname==='/login'&&new URL(page.url()).searchParams.get('next')===null);
+ const teacher=await page.goto(hostname+'/teacher',{waitUntil:'domcontentloaded',timeout:20000});
+ check('teacher protected route redirects to login',new URL(page.url()).pathname==='/login');
+ check('teacher next points to teacher, never admin',new URL(page.url()).searchParams.get('next')==='/teacher');
+ const me=await page.evaluate(async()=>{const r=await fetch('/api/auth/me',{credentials:'omit'});return r.status;});
+ check('anonymous /api/auth/me remains unauthorized',me===401);
+ check('no uncaught HTTPS browser JavaScript errors',errors.length===0);
+ check('all observed browser requests private, outside blocked',requests>0);
+ console.log('HTTPS_PRIVATE_BROWSER_REQ='+requests+' OUTSIDE_BLOCKED='+rejected);
+ console.log('CONNECT_PRIVATE_HTTPS_NGINX_NEXT_BROWSER '+count+'/'+count+' PASS');
+})().catch(e=>{console.error('CONNECT_PRIVATE_HTTPS_FAIL '+e.message);process.exitCode=2;}).finally(async()=>{if(browser)await browser.close()});
