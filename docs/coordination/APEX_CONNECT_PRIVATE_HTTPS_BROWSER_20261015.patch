+'use strict';
+const fs=require('node:fs'),assert=require('node:assert/strict'),path=require('node:path');
+const root=path.resolve(__dirname,'../..');
+const runner=fs.readFileSync(path.join(root,'scripts/connect/replay-private-https-loginonly-20261015.sh'),'utf8');
+const browser=fs.readFileSync(path.join(root,'scripts/connect/test-private-https-loginonly-20261015.cjs'),'utf8');
+let count=0;
+function pass(name,fn){fn();count++;console.log('PASS '+name)}
+pass('exact reviewed Next source pinned',()=>assert(runner.includes('492429340504224a8984a33403d585c747d38fde')));
+pass('exact reviewed compiled Next build pinned',()=>assert(runner.includes('aMD_UNZVOSO2lpyRO0-RO')));
+pass('private Next only loopback',()=>assert(runner.includes('--hostname 127.0.0.1 --port 3016')));
+pass('Nginx binds private loopback exclusively',()=>assert(runner.includes('listen 127.0.0.1:3017 ssl;')));
+pass('TLS cert hostname and expiration preflight',()=>{assert(runner.includes('openssl x509'));assert(runner.includes('-checkhost api.assps.edu.pk'));assert(runner.includes('-checkend 86400'))});
+pass('actual Chromium verifies certificate',()=>assert(browser.includes('ignoreHTTPSErrors:false')));
+pass('Chromium disallows outside host traffic',()=>{assert(browser.includes("route.abort('blockedbyclient')"));assert(browser.includes("u.port===String(port)&&u.protocol==='https:'"));});
+pass('no actual teacher creds or production records',()=>{assert(!runner.includes('pg_restore'));assert(!runner.includes('pm2 restart'));assert(!browser.includes('password='));});
+pass('anonymous teacher login destination verified',()=>assert(browser.includes("searchParams.get('next')==='/teacher'")));
+pass('anonymous identity protection verified',()=>assert(browser.includes('me===401')));
+pass('process groups and cleanup trap enforce safe isolation',()=>{assert(runner.includes('setsid'));assert(runner.includes('trap cleanup EXIT'));assert(runner.includes('kill -- "-$group"'))});
+pass('current live build not used as candidate',()=>assert(!runner.includes('ONDwxEIZlx5onDIKY7wYf')));
+console.log('PRIVATE_HTTPS_SOURCE_ADVERSARIAL '+count+'/'+count+' PASS');
