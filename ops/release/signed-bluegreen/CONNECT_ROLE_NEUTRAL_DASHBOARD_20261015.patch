   };
 
   const base = raw.split("?")[0].replace(/\/+$/, "") || "/";
+  if (base === "/dashboard" || base.startsWith("/dashboard/")) {
+    return getPortalPathForRole(roleFallback || "admin");
+  }
   if (legacy[base]) return legacy[base];
 
   if (base.startsWith("/saas_admin") || base.startsWith("/saas-admin")) {
diff --git a/src/proxy.ts b/src/proxy.ts
index a6c3014..693324c 100644
--- a/src/proxy.ts
+++ b/src/proxy.ts
@@ -171,8 +171,9 @@ export async function proxy(req: NextRequest) {
     if (userId && role) {
       return redirectTo(req, connectPortal(role), 307);
     }
+    // Unknown actor role: do not plant admin destination before login.
+    // The authenticated DB role decides the destination after login.
     const loginUrl = new URL("/login", req.url);
-    loginUrl.searchParams.set("next", "/admin");
     return NextResponse.redirect(loginUrl, 307);
   }
 
@@ -216,7 +217,9 @@ export async function proxy(req: NextRequest) {
     const next = req.nextUrl.searchParams.get("next") || "";
     if (next === "/dashboard" || next.startsWith("/dashboard/") || next.startsWith("/saas-admin")) {
       const loginUrl = req.nextUrl.clone();
-      loginUrl.searchParams.set("next", "/admin");
+      // Discard legacy dashboard/saas-admin target rather than elevate
+      // anonymous user into an admin-intended destination.
+      loginUrl.searchParams.delete("next");
       return NextResponse.redirect(loginUrl, 307);
     }
     if (userId && req.nextUrl.searchParams.get("force") !== "1") {
