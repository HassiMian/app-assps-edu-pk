@@ -30,10 +30,13 @@ export function coerceRedirectPath(path: string, roleFallback?: string): string
     "/saas-admin": "/admin",
     "/school_admin": "/admin",
     "/schooladmin": "/admin",
-    "/dashboard": "/admin",
