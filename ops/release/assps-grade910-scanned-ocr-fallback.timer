[Unit]
Description=ASSPS bounded English source OCR resuming twice nightly with root-private progress

[Timer]
OnCalendar=*-*-* 00:45:00 Asia/Karachi
OnCalendar=*-*-* 05:15:00 Asia/Karachi
RandomizedDelaySec=2m
AccuracySec=1m
Persistent=false
Unit=assps-grade910-scanned-ocr-fallback.service

[Install]
WantedBy=timers.target
