[Unit]
Description=ASSPS independent read-only Grade IX/X source PDF byte and metadata claim audit
After=postgresql.service network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/libexec/assps-grade910-sourceclaims/audit-live-grade910-source-claims-20261016.py

[Service]
Type=oneshot
UMask=0077
StateDirectory=assps-grade910-sourceclaims
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/libexec/assps-grade910-sourceclaims/audit-live-grade910-source-claims-20261016.py --manifest /usr/local/libexec/assps-grade910-sourceclaims/officialSourceManifest.json --original-ledger /usr/local/libexec/assps-grade910-sourceclaims/frozenOriginalResearchIDs.json --out /var/lib/assps-grade910-sourceclaims/latest.json
ExecStartPost=/usr/bin/python3 /usr/local/libexec/assps-grade910-sourceclaims/reconcile-grade910-held-original-candidates-20261016.py --crosswalk /usr/local/libexec/assps-grade910-sourceclaims/originalReviewCrosswalk2581.json --out /var/lib/assps-grade910-sourceclaims/held170.json
ExecStartPost=/usr/bin/python3 /usr/local/libexec/assps-grade910-sourceclaims/assps-grade910-held170-near-duplicate-screen-20261016.py --crosswalk /usr/local/libexec/assps-grade910-sourceclaims/originalReviewCrosswalk2581.json --seed-dir /usr/local/libexec/assps-grade910-sourceclaims/held-stems --held /var/lib/assps-grade910-sourceclaims/held170.json --out /var/lib/assps-grade910-sourceclaims/held170-near-duplicate.json
Environment=ASSPS_CATALOG=/usr/local/libexec/assps-grade910-sourceclaims/officialSourceManifest.json
ExecStartPost=/usr/bin/node /usr/local/libexec/assps-grade910-sourceclaims/verify-grade910-pdf-physical-page-bounds-20261016.mjs
Environment=ASSPS_MANIFEST=/usr/local/libexec/assps-grade910-sourceclaims/officialSourceManifest.json
ExecStartPost=/usr/bin/node /usr/local/libexec/assps-grade910-sourceclaims/verify-grade910-pdf-question-text-evidence-20261016.mjs
ExecStartPost=/usr/bin/python3 /usr/local/libexec/assps-grade910-sourceclaims/audit-grade910-live-answer-integrity-20261016.py
ExecStartPost=/usr/bin/python3 /usr/local/libexec/assps-grade910-sourceclaims/audit-grade910-live-question-collisions-20261016.py
ExecStartPost=/usr/bin/python3 /usr/local/libexec/assps-grade910-sourceclaims/audit-school1-versioned-textbook-adoption-20261016.py
ExecStartPost=/usr/bin/python3 /usr/local/libexec/assps-grade910-sourceclaims/audit-grade910-live-question-revisions-20261016.py
ExecStartPost=/usr/bin/python3 /usr/local/libexec/assps-grade910-sourceclaims/build-grade910-live-source-review-delta-20261016.py
ExecStartPost=/usr/bin/python3 /usr/local/libexec/assps-grade910-sourceclaims/audit-grade910-runtime-question-bank-rls-20261016.py
ExecStartPost=/usr/bin/python3 /usr/local/libexec/assps-grade910-sourceclaims/assps-grade910-autonomous-six-phase-receipt-20261016.py
TimeoutStartSec=300
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/assps-grade910-sourceclaims
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=1G
MemoryMax=1536M
CPUQuota=70%
