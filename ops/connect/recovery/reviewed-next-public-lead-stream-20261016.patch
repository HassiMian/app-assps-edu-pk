 const MAX_PUBLIC_LEAD_JSON_CHARS = 16_384;
+// Raw transport cap: a JSON character limit alone cannot stop an oversized upload.
+const MAX_PUBLIC_LEAD_BODY_BYTES = 65_536;
+
+class PublicLeadPayloadTooLarge extends Error {}
+
+async function readBoundedPublicLeadJson(req: Request): Promise<unknown> {
+  const rawLength = req.headers?.get("content-length");
+  if (rawLength != null) {
+    if (!/^[0-9]+$/.test(rawLength)) {
+      throw new SyntaxError("Invalid Content-Length");
+    }
+    if (Number(rawLength) > MAX_PUBLIC_LEAD_BODY_BYTES) {
+      throw new PublicLeadPayloadTooLarge();
+    }
+  }
+
+  // req.json() supports existing synthetic tests with no ReadableStream.
+  // Real incoming HTTP JSON bodies expose Request.body and are bounded below.
+  if (!req.body) return req.json();
+
+  const reader = req.body.getReader();
+  const parts: Uint8Array[] = [];
+  let size = 0;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      size += value.byteLength;
+      if (size > MAX_PUBLIC_LEAD_BODY_BYTES) {
+        // Stop consuming untrusted content as soon as the cap is exceeded.
+        void reader.cancel().catch(() => {});
+        throw new PublicLeadPayloadTooLarge();
+      }
+      parts.push(value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+
+  const bytes = new Uint8Array(size);
+  let cursor = 0;
+  for (const part of parts) {
+    bytes.set(part, cursor);
+    cursor += part.byteLength;
+  }
+  try {
+    const text = new TextDecoder("utf-8", { fatal: true }).decode(bytes);
+    return JSON.parse(text) as unknown;
+  } catch {
+    throw new SyntaxError("Invalid JSON request");
+  }
+}
