+function streamedJson(raw,headers={}) {
+  const source=typeof raw==='string' ? Buffer.from(raw,'utf8') : raw;
+  let reads=0,cancels=0;
+  const body=new ReadableStream({
+    pull(controller) {
+      reads++;
+      controller.enqueue(source);
+      controller.close();
+    },
+    cancel() { cancels++; }
+  },{highWaterMark:0});
+  return {body,headers:new Headers(headers),json:async()=>{throw Error('unbounded json called');},
+    get reads(){return reads},get cancels(){return cancels}};
+}
+
+test('raw upload larger than transport cap is rejected without persistence or email',async()=>{
+  const h=handler();
+  const input=JSON.stringify({...valid,notes:'x'.repeat(65537)});
+  const request=streamedJson(input);
+  const res=await h.POST(request);
+  assert.equal(res.status,413);
+  assert.equal(res.headers['Cache-Control'],'no-store');
+  assert.equal(h.calls.save,0);
+  assert.equal(h.calls.notify,0);
+});
+
+test('declared large content-length is rejected before reading stream',async()=>{
+  const h=handler();
+  const request=streamedJson(JSON.stringify(valid),{'content-length':'65537'});
+  const res=await h.POST(request);
+  assert.equal(res.status,413);
+  assert.equal(request.reads,0);
+  assert.equal(h.calls.save,0);
+});
+
+test('incorrectly declared short length does not bypass streamed byte cap',async()=>{
+  const h=handler();
