+  const res=await h.POST(request);
+  assert.equal(res.status,400);
+  assert.equal(res.body.message,'Invalid JSON request');
+  assert.equal(h.calls.save,0);
+});
+
+test('multipart chunk transport cumulatively enforces bytes and cancels further reading',async()=>{
+  const h=handler();
+  let reads=0,cancelled=0;
+  const body=new ReadableStream({
+    pull(controller) {
+      reads++;
+      controller.enqueue(new Uint8Array(20_000));
+    },
+    cancel(){cancelled++;}
+  },{highWaterMark:0});
+  const res=await h.POST({body,headers:new Headers(),json:async()=>{throw Error('unbounded json used')}});
+  assert.equal(res.status,413);
+  assert.equal(h.calls.save,0);
