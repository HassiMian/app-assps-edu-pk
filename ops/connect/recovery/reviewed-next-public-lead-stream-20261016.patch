+    {'content-length':'10'});
+  const res=await h.POST(request);
+  assert.equal(res.status,413);
+  assert.equal(h.calls.save,0);
+});
+
+test('malformed content-length is rejected as HTTP400 without disk writes',async()=>{
+  for(const length of ['NaN','-1','6e5','10, 10']){
+    const h=handler();
+    const request=streamedJson(JSON.stringify(valid),{'content-length':length});
+    const res=await h.POST(request);
+    assert.equal(res.status,400);
+    assert.equal(res.headers['Cache-Control'],'no-store');
+    assert.equal(request.reads,0);
+    assert.equal(h.calls.save,0);
+  }
+});
+
+test('valid streamed JSON with multilingual content preserves normal success',async()=>{
+  const h=handler();
+  const request=streamedJson(JSON.stringify({...valid,schoolName:'مدرسہ ASSPS'}));
+  const res=await h.POST(request);
+  assert.equal(res.status,200);
+  assert.equal(res.headers['Cache-Control'],'no-store');
+  assert.equal(h.calls.save,1);
+  assert.equal(h.calls.notify,1);
+});
+
+test('malformed UTF-8 transport is 400 not internal error, with no side effects',async()=>{
+  const h=handler();
