diff --git a/tests/apex-public-lead-mail-safety.test.cjs b/tests/apex-public-lead-mail-safety.test.cjs
new file mode 100644
index 0000000..1a71b7e
--- /dev/null
+++ b/tests/apex-public-lead-mail-safety.test.cjs
@@ -0,0 +1,114 @@
+'use strict';
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const path=require('node:path');
+const vm=require('node:vm');
+const ts=require('typescript');
+const test=require('node:test');
+const root=path.resolve(__dirname,'../src');
+function load(file,imports,globals={}){
+  const source=fs.readFileSync(path.join(root,file),'utf8');
+  const js=ts.transpileModule(source,{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022,esModuleInterop:true}}).outputText;
+  const exports={};
+  vm.runInNewContext(js,{exports,require:(name)=>{
+    if(!Object.prototype.hasOwnProperty.call(imports,name))throw Error('Unmocked dependency '+name);
+    return imports[name];
+  },process:{env:{SMTP_USER:'synthetic',SMTP_PASS:'synthetic',APEX_LEADS_EMAIL:'qa@example.invalid'}},
+  console,Error,SyntaxError,...globals},{timeout:1500,filename:file});
+  return exports;
+}
+const {escapeApexLeadHtml}=load('lib/server/apex-lead-html.ts',{});
+const emails=[];
+const mail=load('lib/server/mail.ts',{
+  nodemailer:{createTransport:()=>({sendMail:async(data)=>{emails.push(data);return {accepted:['synthetic']};}})},
+  fs:{existsSync:()=>true,appendFileSync:()=>{throw Error('unexpected fallback disk write')}},
+  path,
+  '@/lib/server/apex-lead-html':{escapeApexLeadHtml},
+});
+class Response {
+  constructor(body,options={}){this.body=body;this.status=options.status||200;this.headers=options.headers||{};}
+  static json(b,o){return new Response(b,o);}
+}
+function handler({storeFails=false,notifyFails=false,replyFails=false}={}){
+  const calls={save:0,notify:0,reply:0,warns:[]};
+  const route=load('app/api/apex/leads/route.ts',{
+    'next/server':{NextResponse:Response},
+    '@/lib/server/apex-leads-storage':{createApexLead:async(body)=>{
+      calls.save++;
+      if(storeFails)throw Error('PRIVATE_FS_PATH_AND_SMTP_CREDENTIAL');
+      return {...body,leadId:'LEAD-ABCDEF12'};
+    }},
+    '@/lib/server/mail':{
+      sendApexLeadNotification:async()=>{calls.notify++;if(notifyFails)throw Error('PRIVATE_SMTP_HOST_TOKEN');},
+      sendApexLeadAutoReply:async()=>{calls.reply++;if(replyFails)throw Error('PRIVATE_REPLY_ERROR');}
+    }
+  },{console:{warn:(...x)=>calls.warns.push(x.join(' '))}});
+  return {POST:route.POST,calls};
+}
+const valid={type:'contact',name:'Synthetic Name',email:'qa@example.invalid',phone:'000'};
+const req=(input)=>({json:async()=>input});
+test('HTML encoder protects markup metacharacters in lead fields',()=>{
+  assert.equal(escapeApexLeadHtml('<img src=x onerror="alert(1)">&'),
+   '&lt;img src=x onerror=&quot;alert(1)&quot;&gt;&amp;');
+  assert.equal(escapeApexLeadHtml('مدرسہ ASSPS — normal'),'مدرسہ ASSPS — normal');
+});
+test('actual admin and auto-reply email render lead text as literal, not HTML',async()=>{
+  emails.length=0;
+  const attack='<img src=x onerror=alert(1)>';
+  const name='Student & School <svg onload=evil()> "test"';
+  await mail.sendApexLeadNotification({
+    leadId:'LEAD-ABCDEF12',type:'contact',name,
+    email:'qa@example.invalid',phone:'000',schoolName:attack,notes:attack
+  });
+  await mail.sendApexLeadAutoReply({
+    to:'qa@example.invalid',name,type:'contact',leadId:'LEAD-ABCDEF12'
+  });
+  assert.equal(emails.length,2);
+  for(const email of emails){
+    assert.doesNotMatch(email.html,/<img src=x|<svg onload/);
+    assert.match(email.html,/&lt;svg onload=evil\(\)&gt;/);
+    assert.match(email.html,/Student &amp; School/);
+  }
+  assert.match(emails[0].html,/&lt;img src=x onerror=alert\(1\)&gt;/);
+});
+test('saved lead success even if admin notification fails',async()=>{
+  const h=handler({notifyFails:true});
+  const res=await h.POST(req(valid));
+  assert.equal(res.status,200);
+  assert.equal(res.body.success,true);
+  assert.equal(res.body.leadId,'LEAD-ABCDEF12');
+  assert.equal(h.calls.save,1);
+  assert.equal(h.calls.notify,1);
+  assert.equal(h.calls.reply,1);
+  assert.equal(h.calls.warns[0],'APEX_LEAD_NOTIFICATION_FAILED');
+  assert.doesNotMatch(JSON.stringify(res.body),/PRIVATE_SMTP/);
+});
+test('auto-reply failure after save does not fail submission',async()=>{
+  const h=handler({replyFails:true});
+  const res=await h.POST(req(valid));
+  assert.equal(res.status,200);
+  assert.equal(h.calls.save,1);
+});
+test('storage failure redacted no-store on public HTTP500',async()=>{
+  const h=handler({storeFails:true});
+  const res=await h.POST(req(valid));
+  assert.equal(res.status,500);
+  assert.equal(res.body.message,'Unable to submit request');
+  assert.equal(res.headers['Cache-Control'],'no-store');
+  assert.doesNotMatch(JSON.stringify(res.body),/PRIVATE_FS_PATH/);
+  assert.equal(h.calls.notify,0);
+});
+test('malformed JSON is HTTP400 and never creates lead',async()=>{
+  const h=handler();
+  const res=await h.POST({json:async()=>{throw new SyntaxError('Unexpected input')}});
+  assert.equal(res.status,400);
+  assert.equal(res.body.message,'Invalid JSON request');
+  assert.equal(res.headers['Cache-Control'],'no-store');
+  assert.equal(h.calls.save,0);
+});
+test('missing required field stays HTTP400',async()=>{
+  const h=handler();
+  const res=await h.POST(req({...valid,name:''}));
+  assert.equal(res.status,400);
+  assert.equal(h.calls.save,0);
+});
