new file mode 100644
index 0000000..9ec264b
--- /dev/null
+++ b/src/lib/server/apex-lead-html.ts
@@ -0,0 +1,13 @@
+/** Escapes externally supplied lead fields before HTML email interpolation. */
+export function escapeApexLeadHtml(value: string): string {
+  return value.replace(/[&<>"']/g, (character) => {
+    switch (character) {
+      case "&": return "&amp;";
+      case "<": return "&lt;";
+      case ">": return "&gt;";
+      case '"': return "&quot;";
+      case "'": return "&#39;";
+      default: return character;
+    }
+  });
+}
