diff --git a/tests/csv-formula-hardening.test.mjs b/tests/csv-formula-hardening.test.mjs
new file mode 100644
index 0000000..165e781
--- /dev/null
+++ b/tests/csv-formula-hardening.test.mjs
@@ -0,0 +1,48 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+import { fileURLToPath } from "node:url";
+import { dirname, resolve } from "node:path";
+import { escapeCsvCell } from "../src/lib/server/csv-cell.ts";
+
+const dir = dirname(fileURLToPath(import.meta.url));
+const root = resolve(dir, "..");
+
+test("neutralizes spreadsheet formula operators", () => {
+  for (const value of ["=2+2", "+2+2", "-2+2", "@SUM(1)", "\t=2+2",
+                       "  =2+2", "\ufeff=2+2", "\u200b+4",
+                       "\r\n=2+2", "＝2+2"]) {
+    assert.ok(escapeCsvCell(value).startsWith("'") ||
+              escapeCsvCell(value).startsWith("\"'"),
+              JSON.stringify(value));
+  }
+});
+
+test("preserves genuine number types including negatives", () => {
+  assert.equal(escapeCsvCell(-200), "-200");
+  assert.equal(escapeCsvCell(0), "0");
+  assert.equal(escapeCsvCell(300n), "300");
+});
+
+test("quotes commas, double quotes and newlines correctly", () => {
+  assert.equal(escapeCsvCell('abc,def'), '"abc,def"');
+  assert.equal(escapeCsvCell('a"b'), '"a""b"');
+  assert.equal(escapeCsvCell("a\nb"), '"a\nb"');
+  assert.equal(escapeCsvCell('=SUM(1,2)'), '"\'=SUM(1,2)"');
+});
+
+test("does not corrupt normal Urdu and ordinary plain values", () => {
+  assert.equal(escapeCsvCell("السدیق اسکالرز"), "السدیق اسکالرز");
+  assert.equal(escapeCsvCell("teacher@example.com"), "teacher@example.com");
+  assert.equal(escapeCsvCell("+923001234567"), "'+923001234567");
+  assert.equal(escapeCsvCell(null), "");
+});
+
+test("administrative CSV exporters share audited cell encoder", () => {
+  for (const f of ["apex-leads-export.ts", "subscription-request-export.ts"]) {
+    const src = readFileSync(resolve(root, "src/lib/server", f), "utf8");
+    assert.match(src, /import \{ escapeCsvCell \} from ["']@\/lib\/server\/csv-cell["']/);
+    assert.match(src, /\.map\(escapeCsvCell\)/);
+    assert.doesNotMatch(src, /function escapeCsv\(/);
+  }
+});
