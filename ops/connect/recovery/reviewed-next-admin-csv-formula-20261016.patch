diff --git a/src/lib/server/csv-cell.ts b/src/lib/server/csv-cell.ts
new file mode 100644
index 0000000..dd70597
--- /dev/null
+++ b/src/lib/server/csv-cell.ts
@@ -0,0 +1,19 @@
+/**
+ * CSV cell encoder for administrative exports.
+ *
+ * Quoting alone does not prevent formula interpretation in spreadsheet apps.
+ * Prefix formula-like user strings with a literal apostrophe before CSV quoting.
+ * Preserve numeric values as numeric cells, including legitimate negative amounts.
+ */
+export function escapeCsvCell(value: unknown): string {
+  const raw = String(value ?? "");
+  const isNumericValue = typeof value === "number" || typeof value === "bigint";
+  const mayBeFormula = !isNumericValue
+    && /^[\s\u0000-\u001f\u007f-\u009f\u200b\u200e\u200f\u2060\ufeff]*[=+\-@\uff1d\uff0b\uff0d\uff20]/u.test(raw);
+  const text = mayBeFormula ? "'" + raw : raw;
+
+  if (/[",\n\r]/.test(text)) {
+    return '"' + text.replace(/"/g, '""') + '"';
+  }
+  return text;
+}
