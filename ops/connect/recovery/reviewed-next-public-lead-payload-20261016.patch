 export const runtime = "nodejs";
 
+// Public submissions must remain bounded before they reach disk or outbound mail.
+// This guard is additive; the existing valid request/response contract is unchanged.
+const MAX_PUBLIC_LEAD_JSON_CHARS = 16_384;
+const PUBLIC_LEAD_FIELD_LIMITS: Record<string, number> = {
+  type: 40,
+  name: 160,
+  contactName: 160,
+  ownerName: 160,
+  email: 320,
+  phone: 80,
+  contactNumber: 80,
+  schoolName: 240,
+  city: 160,
+  studentsCount: 60,
+  notes: 4_096,
+};
+
+function rejectPublicLead(message: string, status = 400) {
+  return NextResponse.json(
+    { success: false, message },
+    { status, headers: { "Cache-Control": "no-store" } }
+  );
+}
+
+function validPublicLeadPayload(value: unknown): value is Record<string, unknown> {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return false;
+  const body = value as Record<string, unknown>;
+  for (const [key, limit] of Object.entries(PUBLIC_LEAD_FIELD_LIMITS)) {
+    const field = body[key];
+    if (field == null) continue;
+    if (key === "studentsCount" && typeof field === "number" && Number.isFinite(field)) continue;
+    if (typeof field !== "string" || field.length > limit) return false;
+  }
+  const extra = body.extra;
+  if (extra != null) {
+    if (!extra || typeof extra !== "object" || Array.isArray(extra)) return false;
+    const entries = Object.entries(extra);
+    if (entries.length > 32) return false;
+    if (entries.some(([key, val]) =>
+      key.length > 100 || typeof val !== "string" || val.length > 512
+    )) return false;
+  }
+  return true;
+}
