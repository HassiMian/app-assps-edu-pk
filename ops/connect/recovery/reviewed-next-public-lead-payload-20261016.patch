+
+test('public lead rejects null, primitive and array JSON payloads without persistence',async()=>{
+  for(const payload of [null, 1, 'unsafe', [], ['name','email']]){
+    const h=handler();
+    const res=await h.POST({json:async()=>payload});
+    assert.equal(res.status,400);
+    assert.equal(res.headers['Cache-Control'],'no-store');
+    assert.equal(h.calls.save,0);
+    assert.equal(h.calls.notify,0);
+  }
+});
+
+test('public lead rejects non-string form fields and nested extra records',async()=>{
+  for(const payload of [
+    {...valid,name:['unsafe']},
+    {...valid,email:{address:'nested'}},
+    {...valid,notes:{html:'nested'}},
+    {...valid,extra:{tag:{nested:true}}},
+    {...valid,extra:['unexpected']},
+    {...valid,extra:{tag:'x'.repeat(513)}}
+  ]){
+    const h=handler();
+    const res=await h.POST({json:async()=>payload});
+    assert.equal(res.status,400);
+    assert.equal(h.calls.save,0);
+  }
+});
+
+test('public lead rejects oversized fields and total payload without disk/mail writes',async()=>{
+  for(const [payload,status] of [
+    [{...valid,notes:'x'.repeat(4097)},400],
+    [{...valid,name:'x'.repeat(161)},400],
+    [{...valid,unrecognized:'x'.repeat(17000)},413]
+  ]){
+    const h=handler();
+    const res=await h.POST({json:async()=>payload});
+    assert.equal(res.status,status);
+    assert.equal(res.headers['Cache-Control'],'no-store');
+    assert.equal(h.calls.save,0);
+    assert.equal(h.calls.notify,0);
+  }
+});
