+'use strict';
+const assert=require('node:assert/strict');
+const path=require('node:path');
+const fs=require('node:fs');
+const vm=require('node:vm');
+const ts=require('typescript');
+const test=require('node:test');
+const ROOT=path.resolve(__dirname,'../src');
+const DIR='/synthetic/app/data/apex-leads';
+const one={leadId:'LEAD-AAAABBBB',type:'contact',status:'new',name:'Older',email:'older@example.invalid',phone:'000',created_at:'2026-10-01T10:00:00Z'};
+const two={leadId:'LEAD-CCCCDDDD',type:'demo',status:'contacted',name:'Newer',email:'newer@example.invalid',phone:'123',created_at:'2026-10-03T10:00:00Z'};
+
+function error(code, privateMessage='PRIVATE_SQL_PATH_MUST_NOT_LEAK'){
+  return Object.assign(new Error(privateMessage),{code});
+}
+function transpile(rel, imports){
+  const src=fs.readFileSync(path.join(ROOT,rel),'utf8');
+  const js=ts.transpileModule(src,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.CommonJS,esModuleInterop:true}}).outputText;
+  const exports={};
+  vm.runInNewContext(js,{exports,require(id){
+    if(!Object.prototype.hasOwnProperty.call(imports,id))throw Error('Unreviewed dependency '+id);
+    return imports[id];
+  },process:{cwd:()=>'/synthetic/app'},URL,Error,console},{filename:rel,timeout:2000});
+  return exports;
+}
+class Response{
+  constructor(body,options={}){this.body=body;this.status=options.status||200;this.headers=options.headers||{};}
+  static json(data,options){return new Response(data,options);}
+}
+function fixture({existing=[[one.leadId+'.json',one],[two.leadId+'.json',two]],
+                directoryError,readError,authError}={}){
+  const files=new Map(existing.map(([file,item])=>[file,typeof item==='string'?item:JSON.stringify(item)]));
+  const calls={readdir:0,read:[],auth:0,write:0};
+  const stub={
+    readdir:async(dir)=>{
+      calls.readdir++;
+      assert.equal(dir,DIR);
+      if(directoryError)throw error(directoryError);
+      return Array.from(files.keys());
+    },
+    readFile:async(file)=>{
+      calls.read.push(path.basename(file));
+      assert.equal(path.dirname(file),DIR);
+      if(readError)throw error(readError);
+      if(!files.has(path.basename(file)))throw error('ENOENT');
+      return files.get(path.basename(file));
+    },
+    mkdir:async()=>undefined,
+    writeFile:async()=>{calls.write++;throw Error('Unexpected write');}
+  };
+  const storage=transpile('lib/server/apex-leads-storage.ts',{
+    path,'fs/promises':stub,uuid:{v4:()=> 'aaaabbbb-1111-2222-3333-444455556666'}
+  });
+  const handler=transpile('app/api/saas-admin/apex-leads/route.ts',{
+    'next/server':{NextResponse:Response},
+    '@/lib/server/auth-user':{requireSaasAdminUser:async()=>{
+      calls.auth++;
+      if(authError)throw Error(authError);
+    }},
+    '@/lib/server/apex-leads-storage':{listApexLeads:storage.listApexLeads}
+  });
+  return {files,calls,storage,get:handler.GET};
+}
+const req=(s='')=>({url:'https://apex.assps.edu.pk/api/saas-admin/apex-leads'+s});
+
+test('valid old-style records remain visible, sorted newest first and status filtered',async()=>{
+  const h=fixture();
+  const rows=await h.storage.listApexLeads();
+  assert.equal(rows.length,2);
+  assert.equal(rows[0].name,'Newer');
+  assert.equal(rows[1].name,'Older');
+  const contacted=await h.storage.listApexLeads('CONTACTED');
+  assert.equal(contacted.length,1);
+  assert.equal(contacted[0].leadId,two.leadId);
+});
+test('brand-new missing data folder is a genuine empty listing',async()=>{
+  const h=fixture({directoryError:'ENOENT'});
+  const resp=await h.get(req());
+  assert.equal(resp.status,200);
+  assert.equal(resp.headers['Cache-Control'],'no-store');
+  assert.equal(resp.body.data.length,0);
+  assert.equal(h.calls.read.length,0);
+});
+test('permission-denied listing must NOT masquerade as empty records',async()=>{
+  const h=fixture({directoryError:'EACCES'});
+  const resp=await h.get(req());
+  assert.equal(resp.status,500);
+  assert.equal(resp.headers['Cache-Control'],'no-store');
+  assert.equal(resp.body.message,'Administrative request temporarily unavailable');
+  assert.doesNotMatch(JSON.stringify(resp.body),/PRIVATE_SQL_PATH/);
+});
+test('other I/O failures in directory listing are not hidden',async()=>{
+  for(const code of ['EIO','EMFILE']){
+    const h=fixture({directoryError:code});
+    await assert.rejects(h.storage.listApexLeads(),e=>e.code===code);
+  }
+});
+test('unreadable actual file fails protected route instead of silent partial results',async()=>{
+  for(const code of ['EACCES','EIO']){
+    const h=fixture({readError:code});
+    const resp=await h.get(req());
+    assert.equal(resp.status,500);
+    assert.equal(resp.headers['Cache-Control'],'no-store');
+    assert.equal(h.calls.read.length,1);
+    assert.equal(h.calls.write,0);
+  }
+});
+test('stale concurrently deleted filename is skipped and remaining saved data preserved',async()=>{
+  const h=fixture();
+  h.files.delete(one.leadId+'.json');
+  const rows=await h.storage.listApexLeads();
+  assert.equal(rows.length,1);
+  assert.equal(rows[0].leadId,two.leadId);
+});
+test('malformed JSON, null, arrays, forged lead IDs and unknown filenames are excluded',async()=>{
+  const h=fixture({existing:[
+    [one.leadId+'.json',one],
+    ['misc.json',two],
+    ['LEAD-ccccdddd.json',two],
+    [two.leadId+'.json','{malformed-json'],
+    ['LEAD-EEEEFFFF.json',null],
+    ['LEAD-00001111.json',[]],
+    ['LEAD-22223333.json',{...one,leadId:'LEAD-AAAABBBB'}],
+    ['LEAD-44445555.json',{...one,leadId:'LEAD-44445555',created_at:'invalid'}],
+  ]});
+  const rows=await h.storage.listApexLeads();
+  assert.equal(rows.length,1);
+  assert.equal(rows[0].leadId,one.leadId);
+  assert.ok(h.calls.read.every(x=>/^LEAD-[0-9A-F]{8}\.json$/.test(x)));
+});
+test('invalid status and corrupt value types cannot contaminate CSV/admin rows',async()=>{
+  const h=fixture({existing:[
+    [one.leadId+'.json',one],
+    [two.leadId+'.json',{...two,status:'ADMIN'}],
+    ['LEAD-EEEEFFFF.json',{...two,leadId:'LEAD-EEEEFFFF',name:[]}],
+    ['LEAD-FFFFFFFF.json',{...two,leadId:'LEAD-FFFFFFFF',type:'mystery'}],
+  ]});
+  const r=await h.get(req('?status=all'));
+  assert.equal(r.status,200);
+  assert.equal(r.body.data.length,1);
+  assert.equal(r.body.data[0].name,'Older');
+  assert.equal(r.headers['Cache-Control'],'no-store');
+});
+test('unauthenticated actors are denied before any file listing',async()=>{
+  for(const [message,status] of [['Unauthorized',401],['Forbidden',403]]){
+    const h=fixture({authError:message,directoryError:'EACCES'});
+    const r=await h.get(req());
+    assert.equal(r.status,status);
+    assert.equal(h.calls.auth,1);
+    assert.equal(h.calls.readdir,0);
