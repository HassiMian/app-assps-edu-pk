+// Historical valid lead IDs and statuses remain unchanged; corrupt local files
+// must not pollute the administrative list/CSV or masquerade as genuine leads.
+function validStoredApexLead(value: unknown, filename: string): value is ApexLeadRecord {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return false;
+  const record = value as Record<string, unknown>;
+  if (!isApexLeadId(record.leadId) || filename !== `${record.leadId}.json`) return false;
+  if (!["demo", "contact", "register", "enterprise"].includes(String(record.type))) return false;
+  if (typeof record.name !== "string" ||
+      typeof record.email !== "string" ||
+      typeof record.phone !== "string" ||
+      typeof record.created_at !== "string" ||
+      !Number.isFinite(Date.parse(record.created_at))) return false;
+  if (record.status != null &&
+      !["new", "contacted", "archived"].includes(String(record.status).toLowerCase())) return false;
+  return true;
+}
