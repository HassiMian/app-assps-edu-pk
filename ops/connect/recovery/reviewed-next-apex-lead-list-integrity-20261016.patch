+});
+test('non-ENOENT errors never write or delete original JSON lead records',async()=>{
+  const h=fixture({readError:'EIO'});
+  const before=[...h.files.entries()];
+  await assert.rejects(h.storage.listApexLeads(),e=>e.code==='EIO');
