+'use strict';
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const path=require('node:path');
+const vm=require('node:vm');
+const ts=require('typescript');
+const {test}=require('node:test');
+const root=path.resolve(__dirname,'../src');
+function compile(relative,imports={}){
+ const code=ts.transpileModule(fs.readFileSync(path.join(root,relative),'utf8'),{
+  compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.CommonJS,esModuleInterop:true}
+ }).outputText;
+ const exported={};
+ vm.runInNewContext(code,{exports:exported,require:id=>{
+  if(!Object.hasOwn(imports,id))throw Error('unexpected import '+id);
+  return imports[id];
+ },Error,console},{filename:relative,timeout:1800});
+ return exported;
+}
+const {fetchValidatedLeadStats,LatestLeadListRequest}=compile('lib/client/apex-lead-list-request.ts');
+const page=fs.readFileSync(path.join(root,'app/saas-admin/apex-leads/page.tsx'),'utf8');
+const correct={total:3,new:1,contacted:1,archived:1,byType:{demo:2,enterprise:1}};
+const reply=(body=correct)=>({ok:true,json:async()=>({success:true,data:body})});
+test('real valid canonical totals preserve counts unchanged and use no-store',async()=>{
+ let captured;
+ const stats=await fetchValidatedLeadStats(async(url,opt)=>{captured={url,opt};return reply()});
+ assert.equal(stats.total,3);assert.equal(stats.byType.demo,2);
+ assert.equal(captured.url,'/api/saas-admin/apex-leads/stats');
+ assert.equal(captured.opt.cache,'no-store');
+});
+test('auth/permission/transport failures cannot appear as zero statistics',async()=>{
+ for(const code of [401,403,500,503]){
+  await assert.rejects(fetchValidatedLeadStats(async()=>({
+   ok:false,status:code,json:async()=>({success:false,data:correct})
+  })),/APEX_LEAD_STATS_UNAVAILABLE/);
+ }
+ await assert.rejects(fetchValidatedLeadStats(async()=>{throw Error('network lost')}),/network lost/);
+});
+test('HTTP 200 application failure and malformed envelope reject',async()=>{
+ for(const value of [null,[],{},'text',{success:false,data:correct},{success:true},
+  {success:true,data:null},{success:true,data:[]}]){
+  await assert.rejects(fetchValidatedLeadStats(async()=>({ok:true,json:async()=>value})),/APEX_LEAD_STATS_MALFORMED/);
+ }
+});
+test('negative fractional or nonfinite counts and broken status totals reject',async()=>{
+ for(const part of ['total','new','contacted','archived']){
+  for(const value of [-1,1.5,NaN,Infinity,'1',undefined,Number.MAX_SAFE_INTEGER+1]){
+   await assert.rejects(fetchValidatedLeadStats(async()=>reply({...correct,[part]:value})),/APEX_LEAD_STATS_MALFORMED/);
+  }
+ }
+ await assert.rejects(fetchValidatedLeadStats(async()=>reply({...correct,total:4})),/APEX_LEAD_STATS_MALFORMED/);
+});
+test('forged byType keys, wrong type counts, mismatched total and arrays reject',async()=>{
+ for(const byType of [null,[],{}, {'__proto__':3}, {demo:-1,enterprise:4},
+  {demo:2,enterprise:2},{demo:'2',enterprise:1},
+  {demo:2,enterprise:1,unauthorized:0}]){
+  await assert.rejects(fetchValidatedLeadStats(async()=>reply({...correct,byType})),/APEX_LEAD_STATS_MALFORMED/);
+ }
+});
+test('current no-lead statistics stay valid without fabricated totals',async()=>{
+ const value={total:0,new:0,contacted:0,archived:0,byType:{}};
+ const stats=await fetchValidatedLeadStats(async()=>reply(value));
+ assert.equal(stats.total,0);
+ assert.equal(Object.keys(stats.byType).length,0);
+});
+test('slow old status response cannot repopulate stats after newer refresh',async()=>{
+ const request=new LatestLeadListRequest();let finishOld;
+ const oldTicket=request.begin();
+ const old=fetchValidatedLeadStats(()=>new Promise(resolve=>finishOld=resolve));
+ request.invalidate();
+ const nowTicket=request.begin();
+ const latest=await fetchValidatedLeadStats(async()=>reply({total:0,new:0,contacted:0,archived:0,byType:{}}));
+ const shown=[];
+ if(request.isCurrent(nowTicket))shown.push(latest.total);
+ finishOld(reply());
+ const outdated=await old;
+ if(request.isCurrent(oldTicket))shown.push(outdated.total);
+ assert.deepEqual(shown,[0]);
+});
+test('page starts stats in cleared loading state and has fail-closed status + retry',()=>{
+ for(const phrase of ['setLeadStats(null);','setStatsError(false);','setStatsError(true);',
+  'statsRequests.current.begin()','statsRequests.current.invalidate()',
+  'statsRequests.current.isCurrent(revision)','fetchValidatedLeadStats(fetch)',
+  'Enquiry statistics are temporarily unavailable.','Retry statistics','role="status"']){
+  assert.ok(page.includes(phrase),phrase);
+ }
+ assert.ok(page.indexOf('{statsError && (')<page.indexOf('{leadStats && ('));
+});
+class Response{
+ constructor(body,options={}){this.body=body;this.status=options.status||200;this.headers=options.headers||{}}
+ static json(body,options){return new Response(body,options)}
+}
+function route({authError,storageError}={}){
+ let auth=0,reads=0;
+ const handler=compile('app/api/saas-admin/apex-leads/stats/route.ts',{
+  'next/server':{NextResponse:Response},
+  '@/lib/server/auth-user':{requireSaasAdminUser:async()=>{
+   auth++;if(authError)throw Error(authError);
+  }},
+  '@/lib/server/apex-leads-stats':{getApexLeadStats:async()=>{
+   reads++;if(storageError)throw Error(storageError);
+   return correct;
+  }}
+ });
+ return {get:handler.GET,get auth(){return auth},get reads(){return reads}};
+}
+test('real transpiled admin stats handler returns successful no-store and guarded data',async()=>{
+ const h=route();
+ const response=await h.get();
+ assert.equal(response.status,200);
+ assert.equal(response.headers['Cache-Control'],'no-store');
+ assert.equal(response.body.data.total,3);
+ assert.equal(h.auth,1);assert.equal(h.reads,1);
+});
+test('HTTP 401 403 are uncached and never read protected statistics',async()=>{
+ for(const [why,status] of [['Unauthorized',401],['Forbidden',403]]){
+  const h=route({authError:why});
+  const response=await h.get();
+  assert.equal(response.status,status);
+  assert.equal(response.headers['Cache-Control'],'no-store');
+  assert.equal(h.reads,0);
+ }
+});
+test('backend stats storage faults stay redacted no-store 500',async()=>{
+ const h=route({storageError:'PRIVATE_PATH_FROM_BACKEND_MUST_NOT_LEAK'});
+ const result=await h.get();
+ assert.equal(result.status,500);
+ assert.equal(result.headers['Cache-Control'],'no-store');
+ assert.equal(result.body.message,'Administrative request temporarily unavailable');
+ assert.doesNotMatch(JSON.stringify(result.body),/PRIVATE_PATH_FROM_BACKEND_MUST_NOT_LEAK/);
+});
