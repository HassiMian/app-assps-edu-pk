--- a/src/lib/client/apex-lead-list-request.ts
+++ b/src/lib/client/apex-lead-list-request.ts
@@ -39,3 +39,47 @@ export async function fetchValidatedLeadList<T>(
   }
   return result.data as T[];
 }
+
+
+/** Never display cached or malformed privileged lead statistics as current. */
+export type ValidatedLeadStats = {
+  total: number;
+  new: number;
+  contacted: number;
+  archived: number;
+  byType: Record<string, number>;
+};
+
+const KNOWN_LEAD_TYPES = new Set(["demo", "contact", "register", "enterprise"]);
+
+export async function fetchValidatedLeadStats(
+  fetcher: (url: string, options: { cache: "no-store" }) => Promise<LeadListResponse>,
+): Promise<ValidatedLeadStats> {
+  const response = await fetcher("/api/saas-admin/apex-leads/stats", { cache: "no-store" });
+  if (!response.ok) throw new Error("APEX_LEAD_STATS_UNAVAILABLE");
+  const body: unknown = await response.json();
+  if (!body || typeof body !== "object" || Array.isArray(body)) {
+    throw new Error("APEX_LEAD_STATS_MALFORMED");
+  }
+  const envelope = body as Record<string, unknown>;
+  if (envelope.success !== true || !envelope.data ||
+      typeof envelope.data !== "object" || Array.isArray(envelope.data)) {
+    throw new Error("APEX_LEAD_STATS_MALFORMED");
+  }
+  const data = envelope.data as Record<string, unknown>;
+  const safeCount = (value: unknown): value is number =>
+    typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
+  const counts = [data.total, data.new, data.contacted, data.archived];
+  if (!counts.every(safeCount) ||
+      data.total !== (data.new as number) + (data.contacted as number) + (data.archived as number) ||
+      !data.byType || typeof data.byType !== "object" || Array.isArray(data.byType)) {
+    throw new Error("APEX_LEAD_STATS_MALFORMED");
+  }
+  const types = data.byType as Record<string, unknown>;
+  if (Object.entries(types).some(([key, value]) => !KNOWN_LEAD_TYPES.has(key) || !safeCount(value))) {
+    throw new Error("APEX_LEAD_STATS_MALFORMED");
+  }
+  const byTypeTotal = Object.values(types).reduce<number>((sum, count) => sum + (count as number), 0);
+  if (byTypeTotal !== data.total) throw new Error("APEX_LEAD_STATS_MALFORMED");
+  return data as ValidatedLeadStats;
+}
