diff --git a/src/lib/client/apex-lead-list-request.ts b/src/lib/client/apex-lead-list-request.ts
new file mode 100644
index 0000000..d234145
--- /dev/null
+++ b/src/lib/client/apex-lead-list-request.ts
@@ -0,0 +1,41 @@
+/** Protect administrative enquiry lists against stale asynchronous responses. */
+export class LatestLeadListRequest {
+  private revision = 0;
+
+  begin(): number {
+    return ++this.revision;
+  }
+
+  invalidate(): void {
+    this.revision++;
+  }
+
+  isCurrent(revision: number): boolean {
+    return revision === this.revision;
+  }
+}
+
+type LeadListResponse = {
+  ok: boolean;
+  json(): Promise<unknown>;
+};
+
+export async function fetchValidatedLeadList<T>(
+  status: string,
+  fetcher: (url: string, options: { cache: "no-store" }) => Promise<LeadListResponse>,
+): Promise<T[]> {
+  const response = await fetcher(
+    `/api/saas-admin/apex-leads?status=${encodeURIComponent(status)}`,
+    { cache: "no-store" },
+  );
+  if (!response.ok) throw new Error("APEX_LEAD_LIST_UNAVAILABLE");
+  const body: unknown = await response.json();
+  if (!body || typeof body !== "object" || Array.isArray(body)) {
+    throw new Error("APEX_LEAD_LIST_MALFORMED");
+  }
+  const result = body as Record<string, unknown>;
+  if (result.success !== true || !Array.isArray(result.data)) {
+    throw new Error("APEX_LEAD_LIST_MALFORMED");
+  }
+  return result.data as T[];
+}
diff --git a/tests/apex-admin-lead-ui-failclosed.test.cjs b/tests/apex-admin-lead-ui-failclosed.test.cjs
