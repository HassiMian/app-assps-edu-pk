--- /dev/null
+++ b/tests/apex-admin-lead-ui-failclosed.test.cjs
@@ -0,0 +1,105 @@
+'use strict';
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const path=require('node:path');
+const vm=require('node:vm');
+const ts=require('typescript');
+const test=require('node:test');
+const source=path.resolve(__dirname,'../src/lib/client/apex-lead-list-request.ts');
+const pageSource=fs.readFileSync(path.resolve(__dirname,'../src/app/saas-admin/apex-leads/page.tsx'),'utf8');
+const js=ts.transpileModule(fs.readFileSync(source,'utf8'),{compilerOptions:{
+  target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.CommonJS
+}}).outputText;
+const moduleExports={};
+vm.runInNewContext(js,{exports:moduleExports,Error},{filename:source,timeout:2000});
+const {LatestLeadListRequest,fetchValidatedLeadList}=moduleExports;
+
+test('first, invalidated, and new asynchronous revision tracked independently',()=>{
+  const requests=new LatestLeadListRequest();
+  const a=requests.begin();
+  assert.equal(requests.isCurrent(a),true);
+  requests.invalidate();
+  assert.equal(requests.isCurrent(a),false);
+  const b=requests.begin();
+  assert.equal(requests.isCurrent(b),true);
+  assert.equal(requests.isCurrent(a),false);
+});
+test('fast two-filter responses: delayed first result can never supersede newest',async()=>{
+  const seq=new LatestLeadListRequest();
+  let completeOld;
+  const oldFetcher=()=>new Promise(resolve=>{completeOld=resolve});
+  const observed=[];
+  const oldTicket=seq.begin();
+  const old=fetchValidatedLeadList('new',oldFetcher)
+    .then(rows=>{if(seq.isCurrent(oldTicket))observed.push(rows[0].leadId)});
+  const newTicket=seq.begin();
+  const newer=await fetchValidatedLeadList('contacted',async()=>({
+    ok:true,json:async()=>({success:true,data:[{leadId:'LEAD-22222222'}]})
+  }));
+  if(seq.isCurrent(newTicket))observed.push(newer[0].leadId);
+  completeOld({ok:true,json:async()=>({success:true,data:[{leadId:'LEAD-11111111'}]})});
+  await old;
+  assert.deepEqual(observed,['LEAD-22222222']);
+});
+test('transport uses no-store and URL-encodes even unusual filter strings',async()=>{
+  let seen;
+  const result=await fetchValidatedLeadList('new&status=archived',async(url,opt)=>{
+    seen={url,opt};
+    return {ok:true,json:async()=>({success:true,data:[]})};
+  });
+  assert.equal(result.length,0);
+  assert.equal(seen.opt.cache,'no-store');
+  assert.equal(seen.url,'/api/saas-admin/apex-leads?status=new%26status%3Darchived');
+});
+test('an authentication/storage failure rejects rather than converting into empty success',async()=>{
+  for(const code of [401,403,500,503]){
+    await assert.rejects(fetchValidatedLeadList('ALL',async()=>({
+      ok:false,status:code,json:async()=>({success:false,data:[]})
+    })),/APEX_LEAD_LIST_UNAVAILABLE/);
+  }
+});
+test('HTTP200 application failure is not a fake empty result',async()=>{
+  await assert.rejects(fetchValidatedLeadList('new',async()=>({
+    ok:true,json:async()=>({success:false,data:[]})
+  })),/APEX_LEAD_LIST_MALFORMED/);
+});
+test('wrong payload shape, null, arrays and missing data cannot render as leads',async()=>{
+  for(const body of [null,[],{},'oops',{success:true},{success:true,data:null},
+    {success:true,data:{leadId:'LEAD-11111111'}}]){
+    await assert.rejects(fetchValidatedLeadList('new',async()=>({
+      ok:true,json:async()=>body
+    })),/APEX_LEAD_LIST_MALFORMED/);
+  }
+});
+test('network fetch and JSON parsing failures propagate to fail-closed UI',async()=>{
+  await assert.rejects(fetchValidatedLeadList('new',async()=>{throw Error('network unavailable')}),/network unavailable/);
+  await assert.rejects(fetchValidatedLeadList('new',async()=>({
+    ok:true,json:async()=>{throw SyntaxError('invalid JSON')}
+  })),/invalid JSON/);
+});
+test('React UI preserves explicit loading/failure/empty states and latest-only guards',()=>{
+  for(const phrase of [
+    'useRef(new LatestLeadListRequest())',
+    'requests.current.begin()',
+    'requests.current.invalidate()',
+    'requests.current.isCurrent(revision)',
+    'setLeads([])',
+    'setLoadError(true)',
+    'setLoading(false)',
+    'fetchValidatedLeadList<LeadItem>(selectedStatus, fetch)',
+    'role="alert"',
+    'Unable to load enquiries. Your saved records have not been changed.',
+    'Retry loading',
+    'await loadLeads(activeStatus.current)',
+  ])assert.ok(pageSource.includes(phrase),phrase);
+  assert.ok(pageSource.indexOf(') : loadError ? (') < pageSource.indexOf(') : leads.length === 0 ? ('));
+});
+test('successful permitted response retains rows without changing record bytes',async()=>{
+  const stored={leadId:'LEAD-ABCDEF12',status:'new',name:'Immutable stored lead'};
+  const before=JSON.stringify(stored);
+  const result=await fetchValidatedLeadList('new',async()=>({
+    ok:true,json:async()=>({success:true,data:[stored]})
+  }));
+  assert.equal(result[0].leadId,stored.leadId);
+  assert.equal(JSON.stringify(stored),before);
+});
