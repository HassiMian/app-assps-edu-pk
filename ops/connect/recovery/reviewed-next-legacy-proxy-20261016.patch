diff --git a/tests/apex-legacy-proxy-failclosed.test.cjs b/tests/apex-legacy-proxy-failclosed.test.cjs
new file mode 100644
index 0000000..fdfd46c
--- /dev/null
+++ b/tests/apex-legacy-proxy-failclosed.test.cjs
@@ -0,0 +1,104 @@
+'use strict';
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const path=require('node:path');
+const vm=require('node:vm');
+const ts=require('typescript');
+const test=require('node:test');
+const source=fs.readFileSync(path.join(__dirname,'../src/app/api/proxy/[...path]/route.ts'),'utf8');
+const js=ts.transpileModule(source,{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022,esModuleInterop:true}}).outputText;
+const SIZE=1024*1024;
+function mount(fetchImpl) {
+ const exp={};
+ class R extends Response {
+  static json(data,init={}){return new Response(JSON.stringify(data),{
+    status:init.status||200,headers:{'content-type':'application/json',...init.headers}
+  })}
+ }
+ vm.runInNewContext(js,{exports:exp,process:{env:{}},console,
+  require:(id)=>{
+   if(id==='next/server')return {NextResponse:R};
+   if(id==='@/lib/server/env')return {envString:()=> 'http://127.0.0.1:5000/api'};
+   throw Error('Unexpected import '+id);
+  },
+  fetch:fetchImpl,AbortSignal,ArrayBuffer,Uint8Array,TextDecoder,Response,Headers,ReadableStream,Error,URL
+ },{filename:'proxy-route',timeout:2000});
+ return exp;
+}
+const request=(url='http://app.invalid/api/proxy/teacher/records',method='GET',body)=>({
+ method,nextUrl:new URL(url),
+ headers:new Headers(body?{'content-type':'application/json','content-length':String(body.length)}:{}),
+ arrayBuffer:async()=>new TextEncoder().encode(body||'').buffer
+});
+const ctx=(...parts)=>({params:Promise.resolve({path:parts})});
+test('JSON200 remains private no-store and intact',async()=>{
+ const route=mount(async()=>new Response('{"records":[{"id":1}]}',{status:200,headers:{'content-type':'application/json'}}));
+ const r=await route.GET(request(),ctx('teacher','records'));
+ assert.equal(r.status,200);
+ assert.deepEqual(await r.json(),{records:[{id:1}]});
+ assert.match(r.headers.get('cache-control')||'',/no-store/);
+});
+test('JSON401 is never cacheable',async()=>{
+ const route=mount(async()=>new Response('{"message":"unauthorized"}',{status:401,headers:{'content-type':'application/json'}}));
+ const r=await route.GET(request(),ctx('protected'));
+ assert.equal(r.status,401);
+ assert.match(r.headers.get('cache-control')||'',/no-store/);
+});
+test('rejects traversal and delimiter path elements before upstream call',async()=>{
+ let calls=0; const route=mount(async()=>{calls++;return new Response('{}')});
+ for(const element of ['..','.','../../admin','?scope=all','#fragment','%2e%2e','\\backslash']){
+  const r=await route.GET(request(),ctx('school',element));
+  assert.equal(r.status,400,element);
+ }
+ assert.equal(calls,0);
+});
+test('rejects declared 40MB JSON upstream without allocating body',async()=>{
+ let read=false; const route=mount(async()=>({
+  status:200,headers:new Headers({'content-type':'application/json','content-length':String(40*SIZE)}),
+  arrayBuffer:async()=>{read=true;throw Error('SHOULD_NOT_BUFFER')},
+  body:{getReader:()=>{read=true;throw Error('SHOULD_NOT_READ')}}
+ }));
+ const r=await route.GET(request(),ctx('classes'));
+ assert.equal(r.status,502);
+ assert.equal(read,false);
+ assert.match(r.headers.get('cache-control')||'',/no-store/);
+});
+test('rejects malformed backend JSON without reflecting its body',async()=>{
+ const route=mount(async()=>new Response('<PRIVATE_SERVICE_HTML>',{status:200,headers:{'content-type':'application/json'}}));
+ const r=await route.GET(request(),ctx('classes'));
+ assert.equal(r.status,502);
+ assert.ok(!(await r.text()).includes('PRIVATE_SERVICE_HTML'));
+});
+test('replies 204 without attempting forbidden body',async()=>{
+ const route=mount(async()=>new Response(null,{status:204}));
+ const r=await route.DELETE(request('http://app.invalid/api/proxy/drafts','DELETE'),ctx('drafts'));
+ assert.equal(r.status,204);
+ assert.match(r.headers.get('cache-control')||'',/no-store/);
+});
+test('JSON response without declared length is bounded while streaming',async()=>{
+ let read=0;
+ const payload=new Uint8Array(33*SIZE);
+ const upstream={status:200,headers:new Headers({'content-type':'application/json'}),
+  body:new ReadableStream({pull(controller){read++;controller.enqueue(payload);controller.close();}})};
+ const route=mount(async()=>upstream);
+ const r=await route.GET(request(),ctx('records'));
+ assert.equal(r.status,502);
+ assert.equal(read,1);
+ assert.match(r.headers.get('cache-control')||'',/no-store/);
+});
+test('disallows an oversized upload request before backend fetch',async()=>{
+ let calls=0;
+ const route=mount(async()=>{calls++;return new Response('{}')});
+ const req=request('http://app.invalid/api/proxy/uploads/file','POST','');
+ req.headers.set('content-length',String(129*SIZE));
+ const r=await route.POST(req,ctx('uploads','file'));
+ assert.equal(r.status,413);
+ assert.equal(calls,0);
+});
+test('encodes ordinary Unicode path safely and keeps query on canonical API root',async()=>{
+ let captured;
+ const route=mount(async(url)=>{captured=url;return new Response('{}',{headers:{'content-type':'application/json'}})});
+ const r=await route.GET(request('http://app.invalid/api/proxy/classes/%D8%AE?year=2026'),ctx('classes','خ'));
+ assert.equal(r.status,200);
+ assert.equal(captured,'http://127.0.0.1:5000/api/classes/%D8%AE?year=2026');
+});
