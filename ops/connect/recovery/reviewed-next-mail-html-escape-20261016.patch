diff --git a/tests/apex-mail-template-html-escape.test.cjs b/tests/apex-mail-template-html-escape.test.cjs
new file mode 100644
index 0000000..75bf918
--- /dev/null
+++ b/tests/apex-mail-template-html-escape.test.cjs
@@ -0,0 +1,43 @@
+'use strict';
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const path=require('node:path');
+const vm=require('node:vm');
+const ts=require('typescript');
+const {test}=require('node:test');
+const source=fs.readFileSync(path.join(__dirname,'../src/lib/server/mail.ts'),'utf8');
+const js=ts.transpileModule(source,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.CommonJS,esModuleInterop:true}}).outputText;
+const attack='<svg onload=alert(1)>&"\'';
+function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
+function load(){
+ const captures=[];
+ const exp={};
+ const env={SMTP_USER:'synthetic-user',SMTP_PASS:'synthetic-pass'};
+ vm.runInNewContext(js,{exports:exp,console,Date,process:{env,cwd:()=>'/synthetic'},Error,require(id){
+  if(id==='nodemailer')return {createTransport:()=>({sendMail:async x=>{captures.push(x)}})};
+  if(id==='fs')return {existsSync:()=>true,appendFileSync:()=>{throw Error('unexpected disk logging')}};
+  if(id==='path')return path;
+  if(id==='@/lib/server/apex-lead-html')return {escapeApexLeadHtml:escapeHtml};
+  throw Error('unknown '+id);
+ }},{filename:'mail.ts',timeout:2000});
+ return {exp,captures};
+}
+const common={to:'recipient@example.invalid',ownerName:attack,schoolName:attack,requestId:attack,planName:attack,amount:5000,gateway:attack,transactionId:attack,email:attack,password:attack,reason:attack};
+const cases=[
+ ['onboarding credentials', 'sendSchoolCredentialsEmail', common],
+ ['pending payment', 'sendPaymentPendingEmail', common],
+ ['rejected payment', 'sendPaymentRejectedEmail', common],
+ ['confirmed payment', 'sendPaymentConfirmedEmail', common],
+ ['admin payment notification', 'sendPaymentConfirmedAdminNotification', common],
+ ['lead notification (existing escaped baseline)', 'sendApexLeadNotification',{leadId:attack,type:attack,name:attack,email:attack,phone:attack,schoolName:attack,notes:attack}]
+];
+for(const [label,fn,params] of cases){
+ test(label+' keeps untrusted field literal in HTML email',async()=>{
+  const {exp,captures}=load(); await exp[fn](params);
+  assert.equal(captures.length,1);
+  const html=captures[0].html;
+  assert.ok(!html.includes(attack),'raw injected markup rendered in '+fn);
+  assert.ok(!html.includes('<svg onload=alert(1)>'),'active markup rendered in '+fn);
+  assert.ok(html.includes('&lt;svg onload=alert(1)&gt;'),'escaped marker missing in '+fn);
+ });
+}
