diff --git a/tests/apex-lead-id-boundary.test.cjs b/tests/apex-lead-id-boundary.test.cjs
new file mode 100644
index 0000000..4fa8678
--- /dev/null
+++ b/tests/apex-lead-id-boundary.test.cjs
@@ -0,0 +1,139 @@
+'use strict';
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const test = require('node:test');
+const ts = require('typescript');
+const root=path.resolve(__dirname,'../src');
+const leadRoot='/synthetic/connect/data/apex-leads';
+const files=new Map();
+let reads=0,writes=0,sends=0,authCalls=0;
+function transpile(rel, imports) {
+  const src=fs.readFileSync(path.join(root,rel),'utf8');
+  const js=ts.transpileModule(src,{compilerOptions:{
+    target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.CommonJS,esModuleInterop:true
+  }}).outputText;
+  const exp={};
+  vm.runInNewContext(js,{exports:exp,URL,Error,console,process:{cwd:()=>'/synthetic/connect'},
+    require:(id)=>{
+      if(!(id in imports))throw Error('UNREVIEWED_IMPORT:'+id);
+      return imports[id];
+    }},{filename:rel,timeout:1500});
+  return exp;
+}
+const storage=transpile('lib/server/apex-leads-storage.ts',{
+  path, 'fs/promises':{
+    mkdir:async()=>undefined,
+    writeFile:async(p,v)=>{
+      writes++;
+      assert.equal(path.dirname(p),leadRoot,'file write must stay in exact leads directory');
+      files.set(p,v);
+    },
+    readFile:async(p)=>{
+      reads++;
+      assert.equal(path.dirname(p),leadRoot,'file read must stay in exact leads directory');
+      if(!files.has(p))throw Error('ENOENT synthetic lead');
+      return files.get(p);
+    },
+    readdir:async()=>[],
+  },
+  uuid:{v4:()=> 'abcdef12-aaaa-bbbb-cccc-abcdef123456'},
+});
+class Response {
+  constructor(body,opts={}){
+    this.body=body;
+    this.status=opts.status||200;
+    this.headers=opts.headers||{};
+  }
+  static json(b,o){return new Response(b,o);}
+}
+function route(rel,auth='OK'){
+  return transpile(rel,{
+    'next/server':{NextResponse:Response},
+    '@/lib/server/auth-user':{
+      requireSaasAdminUser:async()=>{
+        authCalls++;
+        if(auth!=='OK')throw Error(auth);
+      }
+    },
+    '@/lib/server/apex-leads-storage':storage,
+    '@/lib/server/mail':{sendApexLeadAutoReply:async()=>{
+      sends++;
+      return true;
+    }},
+  }).POST;
+}
+function ctx(id){return {params:Promise.resolve({leadId:id})};}
+const statusRoute='app/api/saas-admin/apex-leads/[leadId]/status/route.ts';
+const followRoute='app/api/saas-admin/apex-leads/[leadId]/follow-up/route.ts';
+const malformed=['../private','../../other','LEAD-ABCDEF12/../private','LEAD-ABCDEF12\\..','LEAD-ABCDEF12%2F..','lead-abcdef12','LEAD-ABCDEF12.json','LEAD-ABCDEFGH','LEAD-ABCDEF123','LEAD-ABCDE12','LEAD-ABCDEF12\u0000','',null,42];
+
+test('canonical generated ID and legitimate read/update keep exact path',async()=>{
+  const lead=await storage.createApexLead({
+    type:'demo',name:'Synthetic Person',email:'fixture@example.invalid',phone:'000'
+  });
+  assert.equal(lead.leadId,'LEAD-ABCDEF12');
+  assert.ok(storage.isApexLeadId(lead.leadId));
+  const saved=await storage.readApexLeadById(lead.leadId);
+  assert.equal(saved.name,'Synthetic Person');
+  const updated=await storage.updateApexLeadStatus(lead.leadId,'contacted');
+  assert.equal(updated.status,'contacted');
+  assert.equal(files.size,1);
+  assert.equal(JSON.parse(files.get(path.join(leadRoot,'LEAD-ABCDEF12.json'))).status,'contacted');
+});
+
+test('path traversal and malformed IDs cannot reach even synthetic filesystem',async()=>{
+ for(const id of malformed){
+  assert.equal(storage.isApexLeadId(id),false,String(id));
+  const before={reads,writes};
+  await assert.rejects(storage.readApexLeadById(id),/INVALID_APEX_LEAD_ID/);
+  await assert.rejects(storage.updateApexLeadStatus(id,'contacted'),/INVALID_APEX_LEAD_ID/);
+  assert.deepEqual({reads,writes},before,'filesystem accessed for '+String(id));
+ }
+});
+
+test('follow-up rejects invalid IDs before filesystem or email',async()=>{
+ const POST=route(followRoute);
+ for(const id of malformed){
+  const before={reads,writes,sends};
+  const response=await POST({},ctx(id));
+  assert.equal(response.status,400);
+  assert.equal(response.body.message,'Invalid lead ID');
+  assert.equal(response.headers['Cache-Control'],'no-store');
+  assert.deepEqual({reads,writes,sends},before);
+ }
+});
+
+test('status update rejects invalid IDs before body parse and filesystem',async()=>{
+ const POST=route(statusRoute);
+ for(const id of malformed){
+  const before={reads,writes};
+  const response=await POST({json:async()=>{throw Error('body parsed before ID rejected')}},ctx(id));
+  assert.equal(response.status,400);
+  assert.deepEqual({reads,writes},before);
+ }
+});
+
+test('both handlers still enforce auth before checking record IDs',async()=>{
+ for(const rel of [followRoute,statusRoute]){
+  for(const [denial,code] of [['Unauthorized',401],['Forbidden',403]]){
+   const before={reads,writes,sends};
+   const response=await route(rel,denial)({json:async()=>({status:'new'})},ctx('BAD'));
+   assert.equal(response.status,code);
+   assert.deepEqual({reads,writes,sends},before);
+  }
+ }
+});
+
+test('valid lead status and follow-up remain functional',async()=>{
+ const status=await route(statusRoute)({json:async()=>({status:'archived'})},ctx('LEAD-ABCDEF12'));
+ assert.equal(status.status,200);
+ assert.equal(status.body.data.status,'archived');
+ const before=sends;
+ const follow=await route(followRoute)({},ctx('LEAD-ABCDEF12'));
+ assert.equal(follow.status,200);
+ assert.equal(follow.body.emailSent,true);
+ assert.equal(sends,before+1);
+ assert.equal(files.size,1);
+});
