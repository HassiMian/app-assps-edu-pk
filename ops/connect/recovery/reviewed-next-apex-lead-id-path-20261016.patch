+export function isApexLeadId(value: unknown): value is string {
+  return typeof value === "string" && /^LEAD-[0-9A-F]{8}$/.test(value);
+}
+
+function leadFilePath(leadId: string): string {
+  if (!isApexLeadId(leadId)) {
