+  }
+  return path.join(leadsDir(), `${leadId}.json`);
+}
+
+export async function readApexLeadById(leadId: string): Promise<ApexLeadRecord> {
+  const raw = await fs.readFile(leadFilePath(leadId), "utf8");
+  return JSON.parse(raw) as ApexLeadRecord;
+}
+
