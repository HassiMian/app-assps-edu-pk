  "status": "ACTIVE_PATTERN_REVIEW_REQUIRED_BEFORE_AUTHORING",
  "goal": "For every Grade IX/X subject, prioritize actual board paper or official model inspection before seeding original current-edition questions; English/Urdu grammar and writing hierarchy require full objective+subjective review.",
  "scope": "ALL_IN_SCOPE_SUBJECTS_ENGLISH_AND_URDU_PRIORITY",
  "coreSeparation": {
    "pastPaper": "STRUCTURE_SKILLS_SECTION_HIERARCHY_AND_MARKS_ONLY",
    "currentOfficialTextbook": "ORIGINAL_QUESTION_CONTENT_AND_ACADEMIC_EVIDENCE",
    "currentOfficialGrammarOrQuaidEInsha": "ORIGINAL_LANGUAGE_GRAMMAR_AND_COMPOSITION_CONTENT",
    "asspsEditor": "EXISTING_PAPER_DOCUMENT_VISUAL_LAYOUT_AND_EDITING_RULES_UNCHANGED"
  },
  "precedence": [
    "FIRST_NEW_SYLLABUS_2026_GRADE9_ACTUAL_BOARD_PAPER_SCANS_WHERE_VERIFIABLE",
    "OFFICIAL_PECTAA_GRADE9_MODEL_AND_PAIRING_IF_ANNEX_VISUALLY_VERIFIED",
    "OTHER_GRADE9_ACTUAL_REGIONAL_PAPERS_SAME_COHORT_GROUP_AND_MEDIUM",
    "OLDER_GRADE10_ACTUAL_PAPERS_FOR_STRUCTURE_ONLY",
    "OFFICIALLY_PUBLISHED_CURRENT_GRADE10_MODEL_ONLY_WHEN_VERIFIED",
    "THIRD_PARTY_PAPERS_DISCOVERY_ONLY_UNTIL_PAGE_AUTHENTICITY_ESTABLISHED"
  ],
  "rules": {
    "beforeEachPaperOrCorpus": "SCAN_AND_REGISTER_ORIGINAL_ACTUAL_PAPER_OBJECTIVE_SUBJECTIVE_OR_VERIFIED_OFFICIAL_MODEL",
    "doNotTreatAnswerKeysAsFullPaper": true,
    "seoYearDoesNotEstablishPaperYear": true,
    "doNotInferExact2027Grade10PatternFrom2026OldCohort": true,
    "olderGrade10PatternStructuralReferenceAllowed": true,
    "neverCopyPastPaperQuestionsOrPassages": true,
    "questionContentMustComeFromCurrentOfficialEdition": true,
    "abstractPastPaperAssessedSkillsOnly": true,
    "exactCategoryHierarchyMustBeBackedByPageReference": true,
    "marksChoiceAndQuestionOrderRequireActualDocumentVerification": true,
    "useASSPSExistingEditorNotBoardPageDesign": true,
    "preserveFullBookDefault": true,
    "alpAndKlpOptionalVerifiedFilters": true,
    "subjectMatterReviewBeforeAcademicApproval": true
  },
  "documentTypeAuthority": {
    "ACTUAL_PAPER": "May establish observed board-year pattern after page review",
    "OFFICIAL_MODEL": "May establish model pattern when actual paper unavailable, label as MODEL",
    "ANSWER_KEY": "Provides key/version evidence only; cannot establish subjective paper hierarchy",
    "THIRD_PARTY_REPRODUCTION": "Must match actual board artifact before pattern authority",
    "INDEX_ONLY": "Discovery only; never a paper pattern evidence"
  },
  "patternHierarchySchema": {
    "paperId": "grade|subject|board|year|session|group|medium",
    "sourceDocumentId": "required for every asserted section",
    "sourcePage": "positive integer required for VERIFIED hierarchy",
    "paperPart": "OBJECTIVE | SUBJECTIVE",
    "sectionId": "stable identifier",
    "parentSectionId": "nullable parent question identity",
    "hierarchyPath": "e.g. Q1 > a > item 1; derived from inspected artifact, not assumed",
    "boardQuestionLabel": "verbatim minimal label only (Q# / part letter)",
    "taskFamily": "MCQ | PROSE | POETRY | DRAMA | COMPREHENSION | TRANSLATION | GRAMMAR | WRITING | OTHER; only when observed",
    "taskSubtype": "specific grammar/composition skill observed, nullable until verified",
    "instructionShape": "attempt any N / compulsory / either-or, derived, no passage copied",
    "itemCount": "nullable until inspected",
    "marksPerItem": "nullable until inspected",
    "sectionMarks": "nullable until inspected",
    "choiceRule": "nullable until inspected",
    "topicOrSkillAnchor": "abstract learning outcome/category; not past-paper stem",
    "authorityState": "PENDING | VERIFIED_ACTUAL | VERIFIED_MODEL | REJECTED"
  },
